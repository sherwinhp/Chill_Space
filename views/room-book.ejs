<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book <%= room.name %> | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "rooms",
        roomsLink: "/#rooms",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section booking-widget">
          <div class="section-head">
            <div>
              <h2>Book <%= room.name %></h2>
              <p>Choose a date and time slot (up to 3 months ahead).</p>
            </div>
          </div>

          <div class="room-details">
            <div class="room-details-card">
              <% if (room.image) { %>
                <img src="<%= room.image %>" alt="<%= room.name %>" />
              <% } %>
              <div class="room-details-body">
                <div class="room-details-head">
                  <div>
                    <h3><%= room.name %></h3>
                    <% if (room.subtitle) { %>
                      <p><%= room.subtitle %></p>
                    <% } %>
                  </div>
                  <div class="room-rating">
                    <div class="rating-score">
                      <strong><%= rating && rating.average ? rating.average.toFixed(1) : "0.0" %></strong>
                      <span>Rating</span>
                    </div>
                    <div class="rating-count">
                      <span><%= rating && rating.count ? rating.count : 0 %> reviews</span>
                    </div>
                  </div>
                </div>
                <p class="room-description"><%= room.description || "No description yet." %></p>
                <div class="room-meta">
                  <span>Capacity: <strong><%= room.capacity %> pax</strong></span>
                  <span>Rate: <strong>$<%= Number(pricing.normalRate).toFixed(2) %>/hr (normal)</strong></span>
                  <span>Peak Rate: <strong>$<%= Number(pricing.peakRate).toFixed(2) %>/hr</strong></span>
                </div>
                <% if (room.features && room.features.length) { %>
                  <div class="room-features">
                    <% room.features.forEach(function(feature) { %>
                      <span><%= feature %></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <div
            class="booking-widget-card"
            data-booking-widget
            data-room-id="<%= room.id %>"
            data-room-name="<%= room.name %>"
            data-normal-rate="<%= pricing.normalRate %>"
            data-peak-rate="<%= pricing.peakRate %>"
          >
            <div class="booking-widget-head">
              <div>
                <h3><%= room.name %></h3>
                <p data-booking-status>Select a day to load available slots.</p>
              </div>
              <div class="booking-legend">
                <span><i class="legend-dot available"></i>Available</span>
                <span><i class="legend-dot peak"></i>Peak day</span>
                <span><i class="legend-dot booked"></i>Fully booked</span>
                <span><i class="legend-dot selected"></i>Selected</span>
              </div>
            </div>
            <div class="booking-calendar" data-booking-calendar></div>
            <div class="booking-slots" data-booking-slots></div>
            <div class="booking-actions">
              <div class="booking-summary" data-booking-summary>
                Select a day and time to continue.
              </div>
              <button class="btn primary" type="button" data-booking-add disabled>Book Slot</button>
            </div>
          </div>

          <div class="room-reviews">
            <div class="section-head split">
              <div>
                <h3>Reviews for <%= room.name %></h3>
                <p>Read what other guests shared about this room.</p>
              </div>
              <a class="btn ghost" href="/reviews/add?roomId=<%= room.id %>">Write a review</a>
            </div>

            <% if (!reviews || !reviews.length) { %>
              <div class="empty-state">
                <h3>No reviews yet.</h3>
                <p>Be the first to share your experience.</p>
              </div>
            <% } else { %>
              <div class="room-review-grid">
                <% reviews.forEach(function(review) { %>
                  <article class="room-review-card">
                    <div class="room-review-head">
                      <div>
                        <strong><%= review.user_name %></strong>
                        <span><%= new Date(review.created_at).toLocaleDateString("en-SG") %></span>
                      </div>
                      <div class="room-review-rating">
                        <div class="review-stars" aria-label="<%= review.rating %> star rating">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <span class="<%= i <= review.rating ? 'filled' : '' %>">&#9733;</span>
                          <% } %>
                        </div>
                        <span>Room <%= Number(review.rating).toFixed(1) %> / 5</span>
                      </div>
                    </div>
                    <div class="room-review-breakdown">
                      <span>Food: <strong><%= Number(review.rating_food || 0).toFixed(1) %></strong></span>
                      <span>Service: <strong><%= Number(review.rating_service || 0).toFixed(1) %></strong></span>
                    </div>
                    <p><%= review.comment %></p>
                    <% if (review.admin_reply) { %>
                      <div class="review-reply">
                        <strong>Admin reply</strong>
                        <p><%= review.admin_reply %></p>
                      </div>
                    <% } %>
                    <% if (review.image_url) { %>
                      <div class="room-review-photo">
                        <img src="<%= review.image_url %>" alt="Review photo" />
                      </div>
                    <% } %>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>
      </main>

      <%- include("partials/footer") %>
    </div>
    <script src="/booking-widget.js"></script>
  </body>
</html>
