<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book <%= room.name %> | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "rooms",
        roomsLink: "/#rooms",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section booking-widget">
          <div class="section-head">
            <div>
              <h2>Book <%= room.name %></h2>
              <p>Choose a date and time slot (up to 3 months ahead).</p>
            </div>
          </div>

          <div class="room-details">
            <div class="room-details-card">
              <% if (room.image_url || room.image) { %>
                <img src="<%= room.image_url %>" alt="<%= room.name %>" />
              <% } %>
              <div class="room-details-body">
                <div class="room-details-head">
                  <div>
                    <h3><%= room.name %></h3>
                    <% if (room.subtitle) { %>
                      <p><%= room.subtitle %></p>
                    <% } %>
                  </div>
                  <div class="room-rating">
                    <div class="rating-score">
                      <strong><%= rating && rating.average ? rating.average.toFixed(1) : "0.0" %></strong>
                      <span>Rating</span>
                    </div>
                    <div class="rating-count">
                      <span><%= rating && rating.count ? rating.count : 0 %> reviews</span>
                    </div>
                  </div>
                </div>
                <p class="room-description"><%= room.description || "No description yet." %></p>
                <div class="room-meta">
                  <span>Capacity: <strong><%= room.capacity %> pax</strong></span>
                  <span>Normal Rate: <strong>$<%= Number(pricing.normalRate || 0).toFixed(2) %>/hr</strong></span>
                  <span>Peak Rate (Weekdays 6pm-11pm, Weekends 1-4pm & 8-11pm): <strong>$<%= Number(pricing.peakRateDisplay || pricing.peakRate || 0).toFixed(2) %>/hr</strong></span>
                </div>
                <% const featuresList = Array.isArray(room.features)
                  ? room.features
                  : String(room.features || "")
                      .split(",")
                      .map((item) => item.trim())
                      .filter(Boolean); %>
                <% if (featuresList && featuresList.length) { %>
                  <div class="room-features">
                    <% featuresList.forEach(function(feature) { %>
                      <span><%= feature %></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <div
            class="booking-widget-card"
            data-booking-widget
            data-room-id="<%= room.id %>"
            data-room-name="<%= room.name %>"
            data-normal-rate="<%= pricing.normalRate %>"
            data-peak-rate="<%= pricing.peakRate %>"
          >
            <div class="booking-widget-head">
              <div>
                <h3><%= room.name %></h3>
                <p data-booking-status>Select a day to load available slots.</p>
              </div>
              <div class="booking-legend">
                <span><i class="legend-dot available"></i>Available</span>
                <span><i class="legend-dot peak"></i>Peak time (Weekdays 6pm-11pm, Weekends 1-4pm & 8-11pm)</span>
                <span><i class="legend-dot booked"></i>Blocked / fully booked</span>
                <span><i class="legend-dot selected"></i>Selected</span>
              </div>
            </div>
            <div class="booking-calendar" data-booking-calendar></div>
            <div class="booking-slots" data-booking-slots></div>
            <% const foodItems = Array.isArray(addons && addons.foods) ? addons.foods : [];
              const drinkItems = Array.isArray(addons && addons.drinks) ? addons.drinks : [];
              const themeItems = Array.isArray(addons && addons.themes) ? addons.themes : [];
            %>
            <div class="addon-package" data-addon-package>
              <div class="addon-package-head">
                <div>
                  <h4>Add-on package (optional)</h4>
                  <p>Pick add-ons and quantities to add after your booking is added to cart.</p>
                </div>
              </div>
              <div class="menu-tabs addon-tabs">
                <button class="menu-tab active" type="button" data-addon-tab="food">Food</button>
                <button class="menu-tab" type="button" data-addon-tab="drink">Beverage</button>
                <button class="menu-tab" type="button" data-addon-tab="theme">Theme</button>
              </div>

              <div class="addon-tab-panel" data-addon-panel="food">
                <% if (!foodItems.length) { %>
                  <div class="empty-state">
                    <h3>No food items available.</h3>
                    <p>Add menu items to show food add-ons here.</p>
                  </div>
                <% } else { %>
                  <div class="menu-grid addon-picker-grid">
                    <% foodItems.forEach(function(item) { %>
                      <% const availabilityClass = item.stockStatus === "low_stock"
                        ? "low-stock"
                        : item.stockStatus === "out_of_stock" || item.stockStatus === "unavailable"
                          ? "unavailable"
                          : "available"; %>
                      <article
                        class="menu-card addon-select-card"
                        data-addon-select-card
                        data-addon-type="food"
                        data-addon-id="<%= item.id %>"
                        data-addon-available="<%= item.isOrderable ? '1' : '0' %>"
                      >
                        <div class="menu-head">
                          <% if (item.imageUrl) { %>
                            <div class="menu-media">
                              <img src="<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy" />
                            </div>
                          <% } else { %>
                            <div class="menu-icon">
                              <i class="bi bi-egg-fried"></i>
                            </div>
                          <% } %>
                          <div class="menu-info">
                            <h3><%= item.name %></h3>
                            <p><%= item.description %></p>
                          </div>
                        </div>
                        <div class="menu-actions">
                          <div class="menu-meta">
                            <% if (item.hasDiscount) { %>
                              <span class="price addon-price">
                                <span class="price-discount">$<%= item.discountedPrice.toFixed(2) %></span>
                                <span class="price-original">$<%= item.basePrice.toFixed(2) %></span>
                              </span>
                              <span class="addon-tag">Room booking price</span>
                            <% } else { %>
                              <span class="price">$<%= item.basePrice.toFixed(2) %></span>
                            <% } %>
                            <span class="availability <%= availabilityClass %>">
                              <%= item.stockLabel || (item.isAvailable ? "Available" : "Unavailable") %>
                            </span>
                          </div>
                          <div class="addon-qty" data-addon-qty>
                            <button
                              type="button"
                              data-qty-action="dec"
                              aria-label="Decrease quantity"
                              disabled
                            >
                              -
                            </button>
                            <span data-qty-value>0</span>
                            <button
                              type="button"
                              data-qty-action="inc"
                              aria-label="Increase quantity"
                              <%= item.isOrderable ? "" : "disabled" %>
                            >
                              +
                            </button>
                          </div>
                        </div>
                      </article>
                    <% }) %>
                  </div>
                <% } %>
                <p class="addon-picker-note">Set quantities for food add-ons (0 = none).</p>
              </div>

              <div class="addon-tab-panel is-hidden" data-addon-panel="drink">
                <% if (!drinkItems.length) { %>
                  <div class="empty-state">
                    <h3>No beverages available.</h3>
                    <p>Add beverage items to show drink add-ons here.</p>
                  </div>
                <% } else { %>
                  <div class="menu-grid addon-picker-grid">
                    <% drinkItems.forEach(function(item) { %>
                      <% const availabilityClass = item.stockStatus === "low_stock"
                        ? "low-stock"
                        : item.stockStatus === "out_of_stock" || item.stockStatus === "unavailable"
                          ? "unavailable"
                          : "available"; %>
                      <article
                        class="menu-card addon-select-card"
                        data-addon-select-card
                        data-addon-type="drink"
                        data-addon-id="<%= item.id %>"
                        data-addon-available="<%= item.isOrderable ? '1' : '0' %>"
                      >
                        <div class="menu-head">
                          <% if (item.imageUrl) { %>
                            <div class="menu-media">
                              <img src="<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy" />
                            </div>
                          <% } else { %>
                            <div class="menu-icon">
                              <i class="bi bi-cup-straw"></i>
                            </div>
                          <% } %>
                          <div class="menu-info">
                            <h3><%= item.name %></h3>
                            <p><%= item.description %></p>
                          </div>
                        </div>
                        <div class="menu-actions">
                          <div class="menu-meta">
                            <% if (item.hasDiscount) { %>
                              <span class="price addon-price">
                                <span class="price-discount">$<%= item.discountedPrice.toFixed(2) %></span>
                                <span class="price-original">$<%= item.basePrice.toFixed(2) %></span>
                              </span>
                              <span class="addon-tag">Room booking price</span>
                            <% } else { %>
                              <span class="price">$<%= item.basePrice.toFixed(2) %></span>
                            <% } %>
                            <span class="availability <%= availabilityClass %>">
                              <%= item.stockLabel || (item.isAvailable ? "Available" : "Unavailable") %>
                            </span>
                          </div>
                          <div class="addon-qty" data-addon-qty>
                            <button
                              type="button"
                              data-qty-action="dec"
                              aria-label="Decrease quantity"
                              disabled
                            >
                              -
                            </button>
                            <span data-qty-value>0</span>
                            <button
                              type="button"
                              data-qty-action="inc"
                              aria-label="Increase quantity"
                              <%= item.isOrderable ? "" : "disabled" %>
                            >
                              +
                            </button>
                          </div>
                        </div>
                      </article>
                    <% }) %>
                  </div>
                <% } %>
                <p class="addon-picker-note">Set quantities for beverage add-ons (0 = none).</p>
              </div>

              <div class="addon-tab-panel is-hidden" data-addon-panel="theme">
                <% if (!themeItems.length) { %>
                  <div class="empty-state">
                    <h3>No themes available.</h3>
                    <p>Add theme items in the menu to offer optional room styling.</p>
                  </div>
                <% } else { %>
                  <div class="menu-grid addon-picker-grid">
                    <% themeItems.forEach(function(item) { %>
                      <% const availabilityClass = item.stockStatus === "low_stock"
                        ? "low-stock"
                        : item.stockStatus === "out_of_stock" || item.stockStatus === "unavailable"
                          ? "unavailable"
                          : "available"; %>
                      <article
                        class="menu-card addon-select-card"
                        data-addon-select-card
                        data-addon-type="theme"
                        data-addon-id="<%= item.id %>"
                        data-addon-available="<%= item.isOrderable ? '1' : '0' %>"
                      >
                        <div class="menu-head">
                          <% if (item.imageUrl) { %>
                            <div class="menu-media">
                              <img src="<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy" />
                            </div>
                          <% } else { %>
                            <div class="menu-icon">
                              <i class="bi bi-stars"></i>
                            </div>
                          <% } %>
                          <div class="menu-info">
                            <h3><%= item.name %></h3>
                            <p><%= item.description %></p>
                          </div>
                        </div>
                        <div class="menu-actions">
                          <div class="menu-meta">
                            <span class="price">$<%= item.basePrice.toFixed(2) %></span>
                            <span class="availability <%= availabilityClass %>">
                              <%= item.stockLabel || (item.isAvailable ? "Available" : "Unavailable") %>
                            </span>
                          </div>
                          <div class="addon-qty" data-addon-qty>
                            <button
                              type="button"
                              data-qty-action="dec"
                              aria-label="Decrease quantity"
                              disabled
                            >
                              -
                            </button>
                            <span data-qty-value>0</span>
                            <button
                              type="button"
                              data-qty-action="inc"
                              aria-label="Increase quantity"
                              <%= item.isOrderable ? "" : "disabled" %>
                            >
                              +
                            </button>
                          </div>
                        </div>
                      </article>
                    <% }) %>
                  </div>
                <% } %>
                <p class="addon-picker-note">Set quantities for theme add-ons (0 = none).</p>
              </div>
              <p class="addon-package-note">
                Add-ons are applied with room booking pricing and added automatically after the slot is booked.
              </p>
            </div>
            <div class="booking-actions">
              <div class="booking-summary" data-booking-summary>
                Select a day and time to continue.
              </div>
              <button class="btn primary" type="button" data-booking-add disabled>Book Slot</button>
            </div>
          </div>


          <div class="room-reviews">
            <div class="section-head split">
              <div>
                <h3>Reviews for <%= room.name %></h3>
                <p>Read what other guests shared about this room.</p>
              </div>
              <a class="btn ghost" href="/reviews/add?roomId=<%= room.id %>">Write a review</a>
            </div>

            <% if (!reviews || !reviews.length) { %>
              <div class="empty-state">
                <h3>No reviews yet.</h3>
                <p>Be the first to share your experience.</p>
              </div>
            <% } else { %>
              <div class="room-review-grid">
                <% reviews.forEach(function(review) { %>
                  <article class="room-review-card">
                    <div class="room-review-head">
                      <div>
                        <strong><%= review.user_name %></strong>
                        <span><%= new Date(review.created_at).toLocaleDateString("en-SG") %></span>
                      </div>
                      <div class="room-review-rating">
                        <div class="review-stars" aria-label="<%= review.rating %> star rating">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <span class="<%= i <= review.rating ? 'filled' : '' %>">&#9733;</span>
                          <% } %>
                        </div>
                        <span>Room <%= Number(review.rating).toFixed(1) %> / 5</span>
                      </div>
                    </div>
                    <div class="room-review-breakdown">
                      <span>Food: <strong><%= Number(review.rating_food || 0).toFixed(1) %></strong></span>
                      <span>Service: <strong><%= Number(review.rating_service || 0).toFixed(1) %></strong></span>
                    </div>
                    <p><%= review.comment %></p>
                    <% if (review.admin_reply) { %>
                      <div class="review-reply">
                        <strong>Admin reply</strong>
                        <p><%= review.admin_reply %></p>
                      </div>
                    <% } %>
                    <% if (review.image_url) { %>
                      <div class="room-review-photo">
                        <img src="<%= review.image_url %>" alt="Review photo" />
                      </div>
                    <% } %>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>
      </main>

      <%- include("partials/footer") %>
    </div>
    <script src="/booking-widget.js"></script>
  </body>
</html>
