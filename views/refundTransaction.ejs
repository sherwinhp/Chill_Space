<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Request Refund | Chill Space</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section">
          <div class="refund-hero">
            <div class="refund-hero-text">
              <span class="eyebrow">Support</span>
              <h2>Refund Request</h2>
              <p>Order #<%= invoice.transaction_id %> - <%= new Date(invoice.created_at).toLocaleString() %></p>
            </div>
            <div class="refund-hero-actions">
              <a class="btn ghost" href="/invoice/<%= invoice.transaction_id %>">Back to invoice</a>
            </div>
          </div>

          <div class="refund-card">
            <div class="refund-layout">
              <div class="refund-panel refund-summary">
                <h3>Order summary</h3>
                <div class="meta refund-meta">
                  <span><strong>Payment:</strong> <%= String(invoice.provider || "unknown").toUpperCase() %></span>
                  <span><strong>Reference:</strong> <%= invoice.provider_order_id || "-" %></span>
                  <span><strong>Total:</strong> $<%= Number(invoice.total_amount || 0).toFixed(2) %></span>
                </div>
                <div class="order-table refund-order">
                  <div class="order-row order-head">
                    <span>Product</span>
                    <span>Qty</span>
                    <span>Price</span>
                    <span>Subtotal</span>
                  </div>
                  <div class="order-rows">
                    <% invoice.items.forEach(function(item) { %>
                      <div class="order-row">
                        <div class="order-product">
                          <strong><%= item.item_name %></strong>
                          <% if (item.details || item.start_time) { %>
                            <div class="order-meta">
                              <% if (item.details) { %>
                                <span><%= item.details %></span>
                              <% } %>
                              <% if (item.start_time && item.end_time) { %>
                                <span>
                                  <%= new Date(item.start_time).toLocaleString() %> -
                                  <%= new Date(item.end_time).toLocaleString() %>
                                </span>
                              <% } %>
                            </div>
                          <% } %>
                        </div>
                        <span class="order-qty"><%= item.qty %></span>
                        <span class="order-price">$<%= Number(item.price).toFixed(2) %></span>
                        <span class="order-subtotal">$<%= Number(item.subtotal).toFixed(2) %></span>
                      </div>
                    <% }) %>
                  </div>
                </div>
                <p class="muted">Please submit clear details so our team can review quickly.</p>
              </div>

              <div class="refund-panel refund-form">
                <% if (refund) { %>
                  <div class="refund-current">
                    <div class="status-row">
                      <span class="status-pill secondary">Refund status: <%= refund.status %></span>
                      <% if (refund.approvedAmount) { %>
                        <span class="status-pill">Approved: $<%= Number(refund.approvedAmount).toFixed(2) %></span>
                      <% } %>
                    </div>
                  </div>
                  <div class="admin-booking-refund" style="margin-top: 12px;">
                    <% if (refund.reasonText) { %>
                      <div><strong>Reason:</strong> <%= refund.reasonText %></div>
                    <% } %>
                    <% if (refund.userMessage) { %>
                      <div><strong>Message:</strong> <%= refund.userMessage %></div>
                    <% } %>
                    <% if (refund.requestedAmount) { %>
                      <div><strong>Requested amount:</strong> $<%= Number(refund.requestedAmount).toFixed(2) %></div>
                    <% } %>
                  </div>
                  <% if (refund.adminNote) { %>
                    <p class="muted" style="margin-top: 1rem;">Admin note: <%= refund.adminNote %></p>
                  <% } %>
                  <% if (refund.imageUrl) { %>
                    <div class="refund-proof">
                      <p class="muted">Uploaded proof:</p>
                      <img src="<%= refund.imageUrl %>" alt="Refund proof" />
                    </div>
                  <% } %>
                <% } else { %>
                  <form
                    class="form refund-form-fields"
                    action="/invoice/<%= invoice.transaction_id %>/refund"
                    method="POST"
                    enctype="multipart/form-data"
                  >
                    <label>
                      <span>Reason</span>
                      <select name="reason" required data-refund-reason>
                        <option value="schedule_change">Schedule change</option>
                        <option value="booking_mistake">Booking made by mistake</option>
                        <option value="room_issue">Room or facility issue</option>
                        <option value="food_issue">Food issue (quality/temperature)</option>
                        <option value="beverage_issue">Beverage issue</option>
                        <option value="theme_issue">Theme add-on issue</option>
                        <option value="wrong_item">Wrong item delivered</option>
                        <option value="delivery_issue">Late delivery</option>
                        <option value="other">Other</option>
                      </select>
                    </label>
                    <p class="muted" data-refund-hint></p>
                    <label>
                      <span>Message</span>
                      <textarea
                        name="message"
                        rows="3"
                        placeholder="Share details for your refund request"
                        data-refund-message
                      ></textarea>
                    </label>
                    <label class="refund-optional" data-refund-amount>
                      <span>Custom refund amount</span>
                      <input
                        type="number"
                        name="requested_amount"
                        step="0.01"
                        min="0.01"
                        max="<%= Number(invoice.total_amount || 0).toFixed(2) %>"
                      />
                      <small>Required only when reason is "Other".</small>
                    </label>
                    <label class="refund-upload">
                      <span>Upload image (optional)</span>
                      <input type="file" name="refund_photo" accept="image/*" />
                      <small>PNG or JPG, up to 3MB.</small>
                      <div class="refund-preview is-hidden" data-refund-preview>
                        <img alt="Refund upload preview" />
                        <span data-refund-preview-name></span>
                      </div>
                      <p class="refund-warning is-hidden" data-refund-warning></p>
                    </label>
                    <div class="form-actions">
                      <button class="btn primary" type="submit">Submit refund request</button>
                    </div>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </section>
      </main>

      <%- include("partials/footer") %>
    </div>
    <script>
      const reasonSelect = document.querySelector("[data-refund-reason]");
      const amountField = document.querySelector("[data-refund-amount]");
      const messageField = document.querySelector("[data-refund-message]");
      const hintEl = document.querySelector("[data-refund-hint]");
      const amountInput = amountField ? amountField.querySelector("input") : null;
      const fileInput = document.querySelector("input[name='refund_photo']");
      const preview = document.querySelector("[data-refund-preview]");
      const previewImg = preview ? preview.querySelector("img") : null;
      const previewName = document.querySelector("[data-refund-preview-name]");
      const warning = document.querySelector("[data-refund-warning]");
      const MAX_SIZE = 3 * 1024 * 1024;

      function setWarning(message) {
        if (!warning) return;
        if (message) {
          warning.textContent = message;
          warning.classList.remove("is-hidden");
        } else {
          warning.textContent = "";
          warning.classList.add("is-hidden");
        }
      }

      const orderTotal = Number("<%= Number(invoice.total_amount || 0).toFixed(2) %>");
      const refundRates = {
        schedule_change: 0.2,
        booking_mistake: 0.3,
        room_issue: 0.8,
        food_issue: 0.5,
        beverage_issue: 0.3,
        theme_issue: 0.4,
        wrong_item: 0.7,
        delivery_issue: 0.2,
      };

      function setHint(text) {
        if (!hintEl) return;
        hintEl.textContent = text || "";
      }

      const customReasons = new Set(["other"]);

      function toggleAmount() {
        if (!reasonSelect || !amountField) return;
        const isCustom = customReasons.has(reasonSelect.value);
        amountField.style.display = isCustom ? "block" : "none";
        if (amountInput) {
          amountInput.disabled = !isCustom;
          amountInput.required = isCustom;
          if (!isCustom) {
            amountInput.value = "";
          }
        }
        if (messageField) {
          messageField.required = isCustom;
        }

        if (!isCustom && refundRates[reasonSelect.value]) {
          const pct = Math.round(refundRates[reasonSelect.value] * 100);
          const amount = (orderTotal * refundRates[reasonSelect.value]).toFixed(2);
          setHint(`Suggested refund for this reason: ${pct}% ($${amount}).`);
        } else if (isCustom) {
          setHint("Custom refund amount required for 'Other'.");
        } else {
          setHint("");
        }
      }

      function handlePreview() {
        if (!fileInput || !preview || !previewImg) return;
        const file = fileInput.files && fileInput.files[0];
        if (!file) {
          preview.classList.add("is-hidden");
          if (previewName) previewName.textContent = "";
          setWarning("");
          return;
        }

        if (!file.type.startsWith("image/")) {
          fileInput.value = "";
          preview.classList.add("is-hidden");
          setWarning("Only image files are allowed.");
          return;
        }

        if (file.size > MAX_SIZE) {
          fileInput.value = "";
          preview.classList.add("is-hidden");
          setWarning("Image is too large. Max 3MB.");
          return;
        }

        const url = URL.createObjectURL(file);
        previewImg.src = url;
        preview.classList.remove("is-hidden");
        if (previewName) previewName.textContent = file.name;
        setWarning("");
      }

      if (reasonSelect) {
        reasonSelect.addEventListener("change", toggleAmount);
        toggleAmount();
      }

      if (fileInput) {
        fileInput.addEventListener("change", handlePreview);
      }
    </script>
  </body>
</html>
