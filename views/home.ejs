<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "rooms",
        roomsLink: "/#rooms",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section" id="rooms">
          <div class="section-head split">
            <div>
              <h2>Gaming Rooms</h2>
              <p>Find the perfect spot for gaming, Netflix, and hanging out with friends.</p>
            </div>
            <div class="search-field">
              <input
                class="search-input"
                type="search"
                placeholder="Search rooms"
                aria-label="Search rooms"
                data-search-input="rooms"
              />
            </div>
          </div>

          <% if (!rooms || !rooms.length) { %>
            <div class="empty-state wide">
              <h3>No rooms available yet.</h3>
              <p>Add room data in the database to populate this page.</p>
            </div>
          <% } else { %>
            <div class="cards">
              <% rooms.forEach(function(room) { %>
                <article
                  class="room-card"
                  data-search-item="rooms"
                  data-search-text="<%= [room.name, room.subtitle, (room.features || []).join(' '), room.capacity, room.pricePerHour].filter(Boolean).join(' ') %>"
                >
                  <div class="card-media">
                    <img src="<%= room.image %>" alt="<%= room.name %>" />
                    <% if (room.isAvailable) { %>
                      <span class="pill">Available</span>
                    <% } %>
                  </div>
                  <div class="card-body">
                    <div class="card-title">
                      <div>
                        <h3><%= room.name %></h3>
                        <p><%= room.subtitle %></p>
                      </div>
                      <div class="price">
                        <strong>$<%= room.pricePerHour %></strong>
                        <span>/hour</span>
                      </div>
                    </div>
                    <div class="meta">Capacity: <%= room.capacity %> people</div>
                    <div class="features">
                      <% room.features.forEach(function(feature) { %>
                        <span><%= feature %></span>
                      <% }) %>
                    </div>
                    <a class="btn primary full" href="/rooms/<%= room.id %>/book">Book Now</a>
                  </div>
                </article>
              <% }) %>
            </div>
            <div class="empty-state wide centered search-empty is-hidden" data-search-empty="rooms">
              <h3>No rooms match your search.</h3>
              <p>Try a different keyword or clear the search.</p>
            </div>
          <% } %>
        </section>

      </main>
      <%- include("partials/footer") %>
    </div>
    <script src="/script.js"></script>
    <script src="/search.js"></script>
  </body>
</html>
