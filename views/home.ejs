<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "rooms",
        roomsLink: "/#rooms",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section rooms-page" id="rooms">
          <div class="section-head split rooms-hero">
            <div>
              <h2>Gaming Rooms</h2>
              <p>Find the perfect spot for gaming, Netflix, and hanging out with friends.</p>
            </div>
            <div class="search-field">
              <input
                class="search-input"
                type="search"
                placeholder="Search rooms"
                aria-label="Search rooms"
                data-search-input="rooms"
              />
            </div>
          </div>

          <% if (!rooms || !rooms.length) { %>
            <div class="empty-state wide">
              <h3>No rooms available yet.</h3>
              <p>Add room data in the database to populate this page.</p>
            </div>
          <% } else { %>
            <div class="cards">
              <% rooms.forEach(function(room) { %>
                <article
                  class="room-card"
                  data-search-item="rooms"
                  data-search-text="<%= [room.name, room.subtitle, (room.features || []).join(' '), room.capacity, room.normalHourlyRate, room.peakHourlyRate].filter(Boolean).join(' ') %>"
                >
                  <div class="card-media">
                    <img src="<%= room.image_url %>" alt="<%= room.name %>" />
                    <% if (room.isAvailable) { %>
                      <span class="pill">Available</span>
                    <% } %>
                  </div>
                  <div class="card-body">
                    <div class="card-title">
                      <div>
                        <h3><%= room.name %></h3>
                        <p><%= room.subtitle %></p>
                      </div>
                      <div class="price room-price">
                        <strong>Normal: $<%= Number(room.normalHourlyRate || 0).toFixed(2) %>/hr</strong>
                        <span> | Peak (Weekdays 6pm-11pm, Weekends 1-4pm & 8-11pm): $<%= Number(room.peakHourlyRateDisplay || room.peakHourlyRate || 0).toFixed(2) %>/hr</span>
                      </div>
                    </div>
                    <div class="meta">Capacity: <%= room.capacity %> people</div>
                    <% const featuresList = Array.isArray(room.features)
                      ? room.features
                      : String(room.features || "")
                          .split(",")
                          .map((item) => item.trim())
                          .filter(Boolean); %>
                    <% if (featuresList.length) { %>
                      <div class="features">
                        <% featuresList.slice(0, 3).forEach(function(feature) { %>
                          <span><%= feature %></span>
                        <% }) %>
                      </div>
                    <% } %>
                    <a class="btn primary full" href="/rooms/<%= room.id %>">Book Now</a>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>

      </main>
      <%- include("partials/footer") %>
    </div>
  </body>
</html>
