<!-- BOOTSTRAP + ICONS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<style>
    /* Active tab styling */
    .nav-link.active {
        font-weight: 600;
        border-bottom: 3px solid black;
        color: black !important;
    }

    .nav-link {
        color: #555 !important;
        font-weight: 500;
        padding-bottom: 8px;
    }

    .nav-link:hover {
        color: black !important;
    }
</style>

<header class="bg-white border-bottom shadow-sm">

    <!-- TOP BAR WITH LOGO + BUTTONS -->
    <div class="container py-3 d-flex justify-content-between align-items-center">

        <!-- LOGO + TAGLINE -->
        <div>
            <h2 class="fw-bold mb-0">Cozy Place Gaming Rooms</h2>
            <small class="text-muted">Your Ultimate Gaming & Chill Spot</small>
        </div>

        <!-- RIGHT BUTTONS -->
        <div class="d-flex align-items-center gap-3">

            <!-- Cart -->
            <a href="/cart" class="text-dark fs-4">
                <i class="fa fa-shopping-cart"></i>
            </a>

            <!-- Register -->
            <a href="/register" class="btn btn-outline-dark rounded-pill px-3">
                Register
            </a>

            <!-- Admin Login -->
            <a href="/admin/login" class="btn btn-dark rounded-pill px-3">
                Admin Login
            </a>
        </div>
    </div>

    <!-- NAVIGATION BAR -->
    <nav class="border-top">
        <div class="container">
            <ul class="nav nav-underline justify-content-start py-2">

                <li class="nav-item">
                    <a class="nav-link <%= (page === 'rooms') ? 'active' : '' %>" href="/rooms">Rooms</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link <%= (page === 'bookings') ? 'active' : '' %>" href="/bookings">Bookings</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link <%= (page === 'menu') ? 'active' : '' %>" href="/menu">Menu</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link <%= (page === 'reviews') ? 'active' : '' %>" href="/reviews">Reviews</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link <%= (page === 'events') ? 'active' : '' %>" href="/events">Events</a>
                </li>

                <!-- Right-aligned icons -->
                <li class="ms-auto nav-item d-flex align-items-center gap-3">

                    <a href="/cart" class="text-dark fs-5">
                        <i class="fa fa-shopping-cart"></i>
                    </a>

                    <a href="/profile" class="text-dark fs-4">
                        <i class="fa fa-user-circle"></i>
                    </a>

                </li>
            </ul>
        </div>
    </nav>

</header>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>