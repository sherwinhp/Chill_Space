<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
/>
<link rel="stylesheet" href="/styles.css" />
<script src="/notify.js" defer></script>
<% const roomsHref = typeof roomsLink !== "undefined" ? roomsLink : "/"; %>
<% const bookingsHref = typeof bookingsLink !== "undefined" ? bookingsLink : "/bookings"; %>
<% const menuHref = typeof menuLink !== "undefined" ? menuLink : "/menu"; %>
<% const reviewsHref = typeof reviewsLink !== "undefined" ? reviewsLink : "/reviews"; %>
<% const eventsHref = typeof eventsLink !== "undefined" ? eventsLink : "/events"; %>
<% const profileHref = typeof profileLink !== "undefined" ? profileLink : "/profile"; %>
<% const hideTabsSafe = typeof hideTabs !== "undefined" ? hideTabs : false; %>
<% const walletBalanceCents = Number(typeof walletBalance !== "undefined" ? walletBalance : 0); %>
<% const walletBalanceLabel = (walletBalanceCents / 100).toFixed(2); %>

<header class="topbar">
  <div class="brand">
    <div class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <rect x="3" y="9" width="4" height="12" rx="1.5"></rect>
        <rect x="10" y="3" width="4" height="18" rx="1.5"></rect>
        <rect x="17" y="6" width="4" height="15" rx="1.5"></rect>
      </svg>
    </div>
    <div>
      <h1>Cozy Place Gaming Rooms</h1>
      <p>Your Ultimate Gaming &amp; Chill Spot</p>
    </div>
  </div>
  <div class="top-actions">
    <a class="icon-btn cart-link" href="/cart" aria-label="Cart">
      <svg viewBox="0 0 24 24" role="img">
        <path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM6.2 6h13.3l-1.5 7.2a2 2 0 0 1-2 1.6H8.3a2 2 0 0 1-2-1.6L4.8 3.6H2"></path>
      </svg>
      <span class="cart-count" data-cart-count aria-hidden="true">0</span>
    </a>
    <% if (session && session.name) { %>
      <span class="welcome-text">Welcome, <%= session.name %></span>
      <% if (session.role === "admin") { %>
        <a class="btn ghost" href="/admin">Admin</a>
      <% } %>
      <form action="/auth/logout" method="post">
        <button class="btn primary" type="submit">Logout</button>
      </form>
    <% } else { %>
      <a class="btn ghost" href="/register">Register</a>
      <a class="btn primary" href="/login">Login</a>
    <% } %>
  </div>
</header>

  <% if (!hideTabsSafe) { %>
    <nav class="tabs" aria-label="Primary">
      <a class="tab <%= page === 'rooms' ? 'active' : '' %>" href="<%= roomsHref %>">Rooms</a>
      <a class="tab <%= page === 'bookings' ? 'active' : '' %>" href="<%= bookingsHref %>">Bookings</a>
      <% if (session && session.name) { %>
        <a class="tab <%= page === 'purchases' ? 'active' : '' %>" href="/purchases">Purchase History</a>
      <% } %>
      <a class="tab <%= page === 'menu' ? 'active' : '' %>" href="<%= menuHref %>">Menu</a>
      <a class="tab <%= page === 'reviews' ? 'active' : '' %>" href="<%= reviewsHref %>">Reviews</a>
      <a class="tab <%= page === 'events' ? 'active' : '' %>" href="<%= eventsHref %>">Events</a>
      <% if (session && session.role === "admin") { %>
        <a class="tab <%= page === 'admin' ? 'active' : '' %>" href="/admin">Admin</a>
      <% } %>
      <a class="tab <%= page === 'profile' ? 'active' : '' %>" href="<%= profileHref %>">Profile</a>
      <% if (session && session.name) { %>
        <a class="tab <%= page === 'wallet' ? 'active' : '' %>" href="/wallet">Wallet: $<%= walletBalanceLabel %></a>
      <% } %>
    </nav>
  <% } %>
  <script src="/cart-badge.js" defer></script>
