<section class="card cart-card">
  <div class="cart-empty">
    <div class="cart-icon">🛒</div>
    <h3>Your cart is empty</h3>
    <p>Add some delicious food and drinks!</p>
  </div>
  <div class="cart-items" hidden></div>
  <div class="cart-summary" hidden>
    <span>Total</span>
    <strong id="cart-total">$0</strong>
    <button class="primary-btn" id="checkout-btn">Checkout</button>
  </div>
</section>
