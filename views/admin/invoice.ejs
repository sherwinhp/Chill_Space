<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Invoice</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-invoices" }) %>

      <main>
        <section class="section invoice-page">
          <div class="invoice-hero">
            <div class="invoice-hero-text">
              <span class="eyebrow">Receipt</span>
              <h2>Invoice</h2>
              <p>Admin view of invoice details.</p>
            </div>
            <div class="invoice-hero-actions">
              <a class="btn ghost" href="/admin/invoices">Back to invoices</a>
              <button class="btn ghost" type="button" onclick="window.print()">Print</button>
            </div>
          </div>

          <div class="invoice-card">
            <div class="invoice-meta">
              <div>
                <span>Invoice</span>
                <strong>#<%= invoice.transaction_id %></strong>
              </div>
              <div>
                <span>Date</span>
                <strong><%= new Date(invoice.created_at).toLocaleString() %></strong>
              </div>
              <div>
                <span>Status</span>
                <strong class="status-pill"><%= invoice.status %></strong>
              </div>
              <div>
                <span>Payment</span>
                <strong class="invoice-value invoice-value--upper"><%= invoice.provider %></strong>
              </div>
              <div>
                <span>Reference</span>
                <strong class="invoice-value invoice-value--wrap"><%= invoice.provider_order_id || "-" %></strong>
              </div>
            </div>

            <div class="invoice-customer">
              <div>
                <span>Billed to</span>
                <strong><%= invoice.user_name %></strong>
                <small><%= invoice.user_email %></small>
              </div>
              <div class="invoice-total">
                <span>Total paid</span>
                <strong>$<%= Number(invoice.total_amount).toFixed(2) %></strong>
              </div>
            </div>

            <div class="order-table invoice-table">
              <div class="order-row order-head">
                <span>Product</span>
                <span>Qty</span>
                <span>Price</span>
                <span>Subtotal</span>
              </div>
              <div class="order-rows">
                <% invoice.items.forEach(function(item) { %>
                  <div class="order-row">
                    <div class="order-product">
                      <strong><%= item.item_name %></strong>
                      <% if (item.details || item.start_time) { %>
                        <div class="order-meta">
                          <% if (item.details) { %>
                            <span><%= item.details %></span>
                          <% } %>
                          <% if (item.start_time && item.end_time) { %>
                            <span>
                              <%= new Date(item.start_time).toLocaleString() %> -
                              <%= new Date(item.end_time).toLocaleString() %>
                            </span>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                    <span class="order-qty"><%= item.qty %></span>
                    <span class="order-price">$<%= Number(item.price).toFixed(2) %></span>
                    <span class="order-subtotal">$<%= Number(item.subtotal).toFixed(2) %></span>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="invoice-actions">
              <a class="btn ghost" href="/admin/refunds">View refunds</a>
              <a class="btn ghost" href="/admin/purchases">View purchases</a>
              <a class="btn primary" href="/admin/transactions">Transaction log</a>
            </div>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
  </body>
</html>
