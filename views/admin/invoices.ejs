<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Invoices</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-invoices" }) %>

      <main>
        <section class="section admin-section">
          <div class="section-head split">
            <div>
              <h2>Invoices</h2>
              <p>All completed transactions with invoice details.</p>
            </div>
            <div class="section-actions">
              <div class="search-field">
                <input
                  class="search-input"
                  type="search"
                  placeholder="Search invoices"
                  aria-label="Search invoices"
                  data-search-input="admin-invoices"
                />
              </div>
              <a class="btn ghost" href="/admin">Back to dashboard</a>
            </div>
          </div>

          <% if (!transactions || !transactions.length) { %>
            <div class="empty-state">
              <h3>No invoices yet.</h3>
              <p>Invoices will appear after payments complete.</p>
            </div>
          <% } else { %>
            <div class="purchase-grid">
              <% transactions.forEach(function(transaction) { %>
                <% const items = itemsByTransaction[transaction.transaction_id] || []; %>
                <div
                  class="purchase-card"
                  data-search-item="admin-invoices"
                  data-search-text="<%= [transaction.transaction_id, transaction.status, transaction.provider, transaction.total_amount, transaction.user_name, transaction.user_email, new Date(transaction.created_at).toLocaleString(), items.map((item) => item.item_name).join(' '), items.map((item) => item.details).join(' ')].filter(Boolean).join(' ') %>"
                >
                  <div class="purchase-head">
                    <div>
                      <h3>Invoice #<%= transaction.transaction_id %></h3>
                      <p><%= new Date(transaction.created_at).toLocaleString() %></p>
                      <p><%= transaction.user_name || "Unknown user" %> · <%= transaction.user_email || "-" %></p>
                    </div>
                    <div class="purchase-total">
                      <span>Total</span>
                      <strong>$<%= Number(transaction.total_amount).toFixed(2) %></strong>
                    </div>
                  </div>

                  <div class="purchase-meta">
                    <span class="status-pill">Status: <%= transaction.status %></span>
                    <span class="status-pill secondary">Paid by: <%= transaction.provider %></span>
                  </div>

                  <div class="purchase-items">
                    <% items.forEach(function(item) { %>
                      <div class="purchase-item">
                        <div>
                          <strong><%= item.item_name %></strong>
                          <% if (item.details || item.start_time) { %>
                            <div class="order-meta">
                              <% if (item.details) { %>
                                <span><%= item.details %></span>
                              <% } %>
                              <% if (item.start_time && item.end_time) { %>
                                <span>
                                  <%= new Date(item.start_time).toLocaleString() %> -
                                  <%= new Date(item.end_time).toLocaleString() %>
                                </span>
                              <% } %>
                            </div>
                          <% } %>
                        </div>
                        <div class="purchase-item-meta">
                          <span>x<%= item.qty %></span>
                          <span>$<%= Number(item.subtotal).toFixed(2) %></span>
                        </div>
                      </div>
                    <% }) %>
                  </div>

                  <div class="purchase-actions">
                    <span class="purchase-count"><%= items.length %> line items</span>
                    <a class="btn" href="/admin/invoices/<%= transaction.transaction_id %>">
                      View invoice
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
            <div class="empty-state search-empty is-hidden" data-search-empty="admin-invoices">
              <h3>No invoices match your search.</h3>
              <p>Try another keyword or clear the search.</p>
            </div>
          <% } %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
  </body>
</html>
