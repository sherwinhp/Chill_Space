<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Events</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-events" }) %>

      <main>
        <section class="section admin-section">
          <div class="section-head split">
            <div>
              <h2>Manage Events</h2>
              <p>Create, update, or remove events.</p>
            </div>
            <div class="section-actions">
              <a class="btn ghost" href="/admin">Back to dashboard</a>
              <a class="btn primary admin-cta" href="/admin/events/new">Create event</a>
            </div>
          </div>

          <div class="event-tabs admin-menu-tabs">
            <button class="event-tab active" type="button" data-admin-tab="upcoming">Upcoming</button>
            <button class="event-tab" type="button" data-admin-tab="ongoing">Ongoing</button>
            <button class="event-tab" type="button" data-admin-tab="past">Past</button>
          </div>

          <div class="admin-menu-grid">
            <% if (!events || !events.length) { %>
              <div class="empty-state">
                <h3>No events yet.</h3>
                <p>Create your first event to share updates.</p>
              </div>
            <% } else { %>
              <% const now = new Date(); %>
              <% events.forEach(function(event) { %>
                <% const start = event.startDate ? new Date(event.startDate) : null; %>
                <% const end = event.endDate ? new Date(event.endDate) : start; %>
                <% const hasStart = start && !isNaN(start.getTime()); %>
                <% const hasEnd = end && !isNaN(end.getTime()); %>
                <% let status = "upcoming"; %>
                <% if (hasStart && hasEnd && start <= now && end >= now) { status = "ongoing"; } %>
                <% if (hasEnd && end < now) { status = "past"; } %>
                <article class="admin-menu-card" data-admin-category="<%= status %>">
                  <div class="admin-menu-media">
                    <% if (event.image) { %>
                      <img src="<%= event.image %>" alt="<%= event.title %>" />
                    <% } else { %>
                      <div class="admin-room-placeholder">No Image</div>
                    <% } %>
                  </div>
                  <div class="admin-menu-body">
                    <div class="admin-menu-title">
                      <div>
                        <h3><%= event.title %></h3>
                        <p>ID: <%= event.id %></p>
                      </div>
                      <div class="admin-menu-price">
                        <span><%= hasStart ? start.toLocaleDateString() : "TBA" %></span>
                      </div>
                    </div>
                    <% if (event.description) { %>
                      <p class="admin-menu-desc"><%= event.description %></p>
                    <% } %>
                    <% const feeValue = Number(event.entryFee || 0); %>
                    <% const capacityValue = event.capacity === null || typeof event.capacity === "undefined" ? null : Number(event.capacity || 0); %>
                    <% const paidPaxValue = Number(event.paidPax || 0); %>
                    <div class="admin-menu-meta">
                      <span class="admin-menu-pill">
                        <%= hasStart ? start.toLocaleDateString() : "TBA" %> - <%= hasEnd ? end.toLocaleDateString() : "TBA" %>
                      </span>
                      <span class="admin-menu-pill"><%= feeValue > 0 ? `Entry $${feeValue.toFixed(2)}` : "Free" %></span>
                      <% if (capacityValue && capacityValue > 0) { %>
                        <span class="admin-menu-pill">Spots <%= paidPaxValue %>/<%= capacityValue %></span>
                        <span class="admin-menu-pill <%= Number(event.spotsLeft || 0) > 0 ? "available" : "unavailable" %>">
                          Left <%= Number(event.spotsLeft ?? 0) %>
                        </span>
                      <% } %>
                      <span class="admin-menu-pill <%= status === "past" ? "unavailable" : "available" %>">
                        <%= status %>
                      </span>
                    </div>
                    <details class="admin-menu-edit">
                      <summary class="btn">Edit event</summary>
                      <form action="/admin/events/<%= event.id %>" method="POST" enctype="multipart/form-data">
                        <div class="admin-menu-edit-grid">
                          <input name="title" value="<%= event.title %>" />
                          <input name="event_date" type="date" value="<%= event.startDate ? new Date(event.startDate).toISOString().slice(0,10) : '' %>" />
                          <input name="end_date" type="date" value="<%= event.endDate ? new Date(event.endDate).toISOString().slice(0,10) : '' %>" />
                          <input name="capacity" type="number" min="0" step="1" placeholder="Capacity (optional)" value="<%= capacityValue === null ? '' : capacityValue %>" />
                          <input name="entry_fee" type="number" min="0" step="0.01" placeholder="Entry fee (optional)" value="<%= feeValue.toFixed(2) %>" />
                          <input type="file" name="image" accept="image/*" />
                          <textarea name="description" rows="2" placeholder="Description"><%= event.description || "" %></textarea>
                        </div>
                        <div class="admin-menu-edit-actions">
                          <button class="btn" type="submit">Save</button>
                          <a class="btn ghost" href="/admin/events/<%= event.id %>/participants">Participants</a>
                          <button class="btn danger" type="submit" formaction="/admin/events/<%= event.id %>/delete">Delete</button>
                        </div>
                        <input type="hidden" name="current_image_url" value="<%= event.image %>" />
                      </form>
                    </details>
                  </div>
                </article>
              <% }) %>
            <% } %>
            <div class="empty-state admin-menu-empty is-hidden">
              <h3>No events in this view.</h3>
              <p>Switch tabs or create a new event.</p>
            </div>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
    <script>
      const adminTabs = document.querySelectorAll("[data-admin-tab]");
      const adminCards = document.querySelectorAll("[data-admin-category]");
      const emptyState = document.querySelector(".admin-menu-empty");

      function normalize(value) {
        return (value || "").toString().toLowerCase();
      }

      function updateAdminFilter(category) {
        const target = normalize(category);
        let visibleCount = 0;
        adminCards.forEach((card) => {
          const cardCategory = normalize(card.dataset.adminCategory);
          const isMatch = cardCategory === target;
          card.classList.toggle("is-hidden", !isMatch);
          if (isMatch) visibleCount += 1;
        });
        if (emptyState) {
          emptyState.classList.toggle("is-hidden", visibleCount > 0);
        }
      }

      if (adminTabs.length && adminCards.length) {
        adminTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            adminTabs.forEach((btn) => btn.classList.remove("active"));
            tab.classList.add("active");
            updateAdminFilter(tab.dataset.adminTab);
          });
        });
        updateAdminFilter(adminTabs[0].dataset.adminTab);
      }
    </script>
  </body>
</html>

