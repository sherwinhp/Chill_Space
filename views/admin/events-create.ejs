<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Event</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-events" }) %>

      <main>
        <section class="section admin-section">
          <div class="section-head split">
            <div>
              <h2>Create Event</h2>
              <p>Add a new event for customers.</p>
            </div>
            <div class="section-actions">
              <a class="btn ghost" href="/admin/events">Back to events</a>
              <a class="btn" href="/admin">Back to dashboard</a>
            </div>
          </div>

          <form class="admin-form" action="/admin/events" method="POST" enctype="multipart/form-data">
            <h3>Event Details</h3>
            <div class="admin-grid-form">
              <input name="title" type="text" placeholder="Title" maxlength="120" required />
              <input name="event_date" type="date" required />
              <input name="end_date" type="date" required />
              <input name="capacity" type="number" min="0" step="1" placeholder="Capacity (optional)" />
              <input name="entry_fee" type="number" min="0" step="0.01" placeholder="Entry fee (optional)" />
              <input name="image" type="file" accept="image/*" />
              <textarea name="description" rows="2" maxlength="500" placeholder="Description"></textarea>
            </div>
            <button class="btn primary admin-cta" type="submit">Create Event</button>
          </form>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
  </body>
</html>
