<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin" }) %>

      <main>
        <section class="section admin-dashboard">
          <div class="admin-hero">
            <div class="admin-hero-text">
              <span class="admin-pill">Operations Snapshot</span>
              <h2>Admin Dashboard</h2>
              <p>Monitor revenue, keep bookings on track, and stay ahead of events.</p>
            </div>
            <div class="admin-hero-actions">
              <a class="btn primary" href="/admin/bookings">Manage bookings</a>
              <a class="btn ghost" href="/admin/menu">Update menu</a>
            </div>
          </div>

          <div class="admin-stats">
            <article class="admin-stat admin-stat--revenue">
              <span>Total Revenue</span>
              <strong>$<%= Number(salesSummary.total_revenue || 0).toFixed(2) %></strong>
              <small>Lifetime sales</small>
            </article>
            <article class="admin-stat admin-stat--orders">
              <span>Orders</span>
              <strong><%= salesSummary.total_orders || 0 %></strong>
              <small>All completed payments</small>
            </article>
            <article class="admin-stat admin-stat--today">
              <span>Today</span>
              <strong>$<%= Number(salesSummary.revenue_today || 0).toFixed(2) %></strong>
              <small>Revenue in the last 24h</small>
            </article>
            <article class="admin-stat admin-stat--week">
              <span>Last 7 Days</span>
              <strong>$<%= Number(salesSummary.revenue_7d || 0).toFixed(2) %></strong>
              <small>Weekly momentum</small>
            </article>
          </div>

          <div class="admin-panels">
            <div class="admin-panel">
              <div class="admin-panel-head">
                <div>
                  <h3>Upcoming bookings</h3>
                  <p>Next confirmed slots on the calendar.</p>
                </div>
                <a class="btn ghost" href="/admin/bookings">View all</a>
              </div>
              <% if (!upcomingBookings || !upcomingBookings.length) { %>
                <div class="empty-state">
                  <h3>No upcoming bookings.</h3>
                  <p>Bookings will appear here when created.</p>
                </div>
              <% } else { %>
                <div class="admin-activity-list">
                  <% upcomingBookings.forEach(function(booking) { %>
                    <% const bookingStart = new Date(booking.startTime); %>
                    <div class="admin-activity">
                      <div class="admin-activity-time">
                        <span class="admin-activity-day"><%= bookingStart.toLocaleDateString("en-SG", { month: "short", day: "numeric" }) %></span>
                        <span class="admin-activity-hour"><%= bookingStart.toLocaleTimeString("en-SG", { hour: "2-digit", minute: "2-digit" }) %></span>
                      </div>
                      <div class="admin-activity-info">
                        <strong><%= booking.roomName %></strong>
                        <span><%= booking.userName %> &middot; <%= booking.userEmail %></span>
                      </div>
                      <div class="admin-activity-meta">
                        <span class="admin-chip">Payment: <%= booking.paymentStatus %></span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <div class="admin-panel">
              <div class="admin-panel-head">
                <div>
                  <h3>Upcoming events</h3>
                  <p>Major events you should prepare for.</p>
                </div>
                <a class="btn ghost" href="/admin/events">Manage</a>
              </div>
              <% if (!upcomingEvents || !upcomingEvents.length) { %>
                <div class="empty-state">
                  <h3>No upcoming events.</h3>
                  <p>Create events to keep the calendar full.</p>
                </div>
              <% } else { %>
                <div class="admin-activity-list">
                  <% upcomingEvents.forEach(function(event) { %>
                    <% const eventStart = new Date(event.startDate); %>
                    <% const eventEnd = new Date(event.endDate); %>
                    <div class="admin-activity">
                      <div class="admin-activity-time">
                        <span class="admin-activity-day"><%= eventStart.toLocaleDateString("en-SG", { month: "short", day: "numeric" }) %></span>
                        <span class="admin-activity-hour"><%= eventEnd.toLocaleDateString("en-SG", { month: "short", day: "numeric" }) %></span>
                      </div>
                      <div class="admin-activity-info">
                        <strong><%= event.title %></strong>
                        <span><%= event.description || "No description" %></span>
                      </div>
                      <div class="admin-activity-meta">
                        <span class="admin-chip admin-chip--neutral">Event</span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
  </body>
</html>
