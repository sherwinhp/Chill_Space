<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Users</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-users" }) %>

      <main>
        <section class="section admin-section admin-vertical-cards">
          <div class="section-head split">
            <div>
              <h2>Manage Users</h2>
              <p>Create, update, or delete users.</p>
            </div>
            <div class="section-actions">
              <div class="search-field">
                <input
                  class="search-input"
                  type="search"
                  placeholder="Search users"
                  aria-label="Search users"
                  data-search-input="admin-users"
                />
              </div>
              <a class="btn ghost" href="/admin">Back to dashboard</a>
              <a class="btn primary admin-cta" href="/admin/users/new">Create user</a>
            </div>
          </div>

          <div class="event-tabs admin-menu-tabs">
            <button class="event-tab active" type="button" data-admin-tab="user">Users</button>
            <button class="event-tab" type="button" data-admin-tab="admin">Admins</button>
            <button class="event-tab" type="button" data-admin-tab="inactive">Inactive</button>
          </div>

          <div class="admin-menu-grid">
            <% if (!users || !users.length) { %>
              <div class="empty-state">
                <h3>No users yet.</h3>
                <p>Create your first user account.</p>
              </div>
            <% } else { %>
                <% users.forEach(function(user) { %>
                <% const status = user.is_active ? user.role : "inactive"; %>
                <% const kycStatus = user.kyc_status || "unverified"; %>
                <% const kycClass = kycStatus === "verified" ? "available" : (kycStatus === "blocked" || kycStatus === "rejected") ? "unavailable" : "secondary"; %>
                <article
                  class="admin-menu-card"
                  data-admin-category="<%= status %>"
                  data-search-text="<%= [user.name, user.email, user.role, user.id, user.is_active ? 'active' : 'inactive', kycStatus].filter(Boolean).join(' ') %>"
                >
                  <div class="admin-menu-media">
                    <% if (user.avatar_url) { %>
                      <img src="<%= user.avatar_url %>" alt="<%= user.name %>" />
                    <% } else { %>
                      <div class="admin-room-placeholder"><%= (user.name || "?").charAt(0).toUpperCase() %></div>
                    <% } %>
                  </div>
                  <div class="admin-menu-body">
                    <div class="admin-menu-title">
                      <div>
                        <h3><%= user.name %></h3>
                        <p><%= user.email %></p>
                      </div>
                      <div class="admin-menu-price">
                        <span><%= user.role %></span>
                      </div>
                    </div>
                    <div class="admin-menu-meta">
                      <span class="admin-menu-pill">ID <%= user.id %></span>
                      <span class="admin-menu-pill <%= user.is_active ? "available" : "unavailable" %>">
                        <%= user.is_active ? "Active" : "Inactive" %>
                      </span>
                      <span class="admin-menu-pill <%= kycClass %>">KYC: <%= kycStatus %></span>
                    </div>
                    <details class="admin-menu-edit">
                      <summary class="btn">Edit user</summary>
                      <form action="/admin/users/<%= user.id %>" method="POST">
                        <div class="admin-menu-edit-grid">
                          <input name="name" value="<%= user.name %>" />
                          <input name="email" value="<%= user.email %>" />
                          <input name="password" type="text" placeholder="New password (optional)" />
                          <select name="role">
                            <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
                            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                          </select>
                          <select name="is_active">
                            <option value="1" <%= user.is_active ? 'selected' : '' %>>Active</option>
                            <option value="0" <%= user.is_active ? '' : 'selected' %>>Deactivate</option>
                          </select>
                          <select name="kyc_status">
                            <option value="unverified" <%= kycStatus === 'unverified' ? 'selected' : '' %>>KYC: Unverified</option>
                            <option value="pending" <%= kycStatus === 'pending' ? 'selected' : '' %>>KYC: Pending</option>
                            <option value="verified" <%= kycStatus === 'verified' ? 'selected' : '' %>>KYC: Verified</option>
                            <option value="rejected" <%= kycStatus === 'rejected' ? 'selected' : '' %>>KYC: Rejected</option>
                            <option value="blocked" <%= kycStatus === 'blocked' ? 'selected' : '' %>>KYC: Blocked</option>
                          </select>
                        </div>
                        <div class="admin-menu-edit-actions">
                          <button class="btn" type="submit">Save</button>
                          <button class="btn danger" type="submit" formaction="/admin/users/<%= user.id %>/delete" <%= user.role === 'admin' ? 'disabled' : '' %>>
                            Delete
                          </button>
                        </div>
                      </form>
                    </details>
                    <a class="btn ghost" href="/admin/users/<%= user.id %>/purchases">View order history</a>
                  </div>
                </article>
              <% }) %>
            <% } %>
            <div class="empty-state admin-menu-empty is-hidden">
              <h3>No users in this view.</h3>
              <p>Switch tabs or create a new user.</p>
            </div>
            <div class="empty-state search-empty is-hidden" data-search-empty="admin-users">
              <h3>No users match your search.</h3>
              <p>Try another keyword or clear the search.</p>
            </div>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
    <script>
      const adminTabs = document.querySelectorAll("[data-admin-tab]");
      const adminCards = document.querySelectorAll("[data-admin-category]");
      const emptyState = document.querySelector(".admin-menu-empty");
      const searchInput = document.querySelector('[data-search-input="admin-users"]');
      const searchEmpty = document.querySelector('[data-search-empty="admin-users"]');

      function normalize(value) {
        return (value || "").toString().toLowerCase();
      }

      function getActiveCategory() {
        const activeTab = document.querySelector("[data-admin-tab].active");
        if (activeTab && activeTab.dataset.adminTab) {
          return activeTab.dataset.adminTab;
        }
        return adminTabs.length ? adminTabs[0].dataset.adminTab : "user";
      }

      function updateAdminFilter() {
        const target = normalize(getActiveCategory());
        const query = normalize(searchInput ? searchInput.value : "");
        let categoryCount = 0;
        let visibleCount = 0;
        adminCards.forEach((card) => {
          const cardCategory = normalize(card.dataset.adminCategory);
          const inCategory = cardCategory === target;
          if (inCategory) categoryCount += 1;
          const text = normalize(card.dataset.searchText || card.textContent);
          const isMatch = inCategory && (!query || text.includes(query));
          card.classList.toggle("is-hidden", !isMatch);
          if (isMatch) visibleCount += 1;
        });
        if (emptyState) {
          emptyState.classList.toggle("is-hidden", categoryCount > 0 || query);
        }
        if (searchEmpty) {
          searchEmpty.classList.toggle("is-hidden", !query || visibleCount > 0);
        }
      }

      if (adminTabs.length && adminCards.length) {
        adminTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            adminTabs.forEach((btn) => btn.classList.remove("active"));
            tab.classList.add("active");
            updateAdminFilter();
          });
        });
        updateAdminFilter();
      }

      if (searchInput) {
        searchInput.addEventListener("input", updateAdminFilter);
      }
    </script>
  </body>
</html>

