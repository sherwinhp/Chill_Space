<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Promotion</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-promotions" }) %>

      <main>
        <section class="section admin-section">
          <div class="section-head split">
            <div>
              <h2>Create Promotion</h2>
              <p>Set up a new promotion for customers.</p>
            </div>
            <div class="section-actions">
              <a class="btn ghost" href="/admin/promotions">Back to promotions</a>
              <a class="btn" href="/admin">Back to dashboard</a>
            </div>
          </div>

          <form class="admin-form" action="/admin/promotions" method="POST" enctype="multipart/form-data">
            <h3>Promotion Details</h3>
            <div class="admin-grid-form">
              <input name="title" type="text" placeholder="Title" required />
              <input name="code" type="text" placeholder="Code" />
              <input name="discount_percent" type="number" placeholder="Discount %" required />
              <input name="min_total" type="number" step="0.01" placeholder="Min Total" />
              <input name="start_date" type="date" required />
              <input name="end_date" type="date" required />
              <label class="admin-inline-check" style="grid-column: 1 / -1;">
                <input type="checkbox" name="is_hidden" value="1" />
                Hide from users
              </label>
              <input name="image" type="file" accept="image/*" />
              <textarea name="description" rows="2" placeholder="Description"></textarea>
            </div>
            <button class="btn primary admin-cta" type="submit">Create Promotion</button>
          </form>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
  </body>
</html>
