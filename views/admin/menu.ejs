<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Menu</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-menu" }) %>

      <main>
        <section class="section admin-section">
          <div class="section-head split">
            <div>
              <h2>Manage Menu</h2>
              <p>Create, update, or remove menu items.</p>
            </div>
            <div class="section-actions">
              <div class="search-field">
                <input
                  class="search-input"
                  type="search"
                  placeholder="Search menu"
                  aria-label="Search menu"
                  data-search-input="admin-menu"
                />
              </div>
              <a class="btn ghost" href="/admin">Back to dashboard</a>
              <a class="btn primary admin-cta" href="/admin/menu/new">Create menu</a>
            </div>
          </div>

          <div class="event-tabs admin-menu-tabs">
            <button class="event-tab active" type="button" data-menu-tab="food">Food</button>
            <button class="event-tab" type="button" data-menu-tab="drink">Beverages</button>
            <button class="event-tab" type="button" data-menu-tab="addon">Room Themes</button>
          </div>

          <div class="admin-menu-grid">
            <% if (!menuItems || !menuItems.length) { %>
              <div class="empty-state">
                <h3>No menu items yet.</h3>
                <p>Create your first item to populate this category.</p>
              </div>
            <% } else { %>
              <% const categoryLabels = { food: "Food", drink: "Beverages", addon: "Room Themes" }; %>
              <% menuItems.forEach(function(item) { %>
                <article
                  class="admin-menu-card"
                  data-menu-category="<%= item.category %>"
                  data-search-text="<%= [item.name, item.description, item.category, item.id].filter(Boolean).join(' ') %>"
                >
                  <div class="admin-menu-media">
                    <% if (item.image) { %>
                      <img src="<%= item.image %>" alt="<%= item.name %>" />
                    <% } else { %>
                      <div class="admin-room-placeholder">No Image</div>
                    <% } %>
                  </div>
                  <div class="admin-menu-body">
                    <div class="admin-menu-title">
                      <div>
                        <h3><%= item.name %></h3>
                        <p>ID: <%= item.id %></p>
                      </div>
                      <div class="admin-menu-price">
                        $<%= Number(item.price).toFixed(2) %>
                      </div>
                    </div>
                    <div class="admin-menu-meta">
                      <span class="admin-menu-pill"><%= categoryLabels[item.category] || item.category %></span>
                      <span class="admin-menu-pill <%= item.isAvailable ? 'available' : 'unavailable' %>">
                        <%= item.isAvailable ? 'Available' : 'Unavailable' %>
                      </span>
                    </div>
                    <details class="admin-menu-edit">
                      <summary class="btn">Edit item</summary>
                      <form action="/admin/menu/<%= item.id %>" method="POST" enctype="multipart/form-data">
                        <div class="admin-menu-edit-grid">
                          <input name="name" value="<%= item.name %>" />
                          <select name="category">
                            <option value="food" <%= item.category === 'food' ? 'selected' : '' %>>Food</option>
                            <option value="drink" <%= item.category === 'drink' ? 'selected' : '' %>>Beverages</option>
                            <option value="addon" <%= item.category === 'addon' ? 'selected' : '' %>>Room Themes</option>
                          </select>
                          <input name="price" type="number" step="0.01" value="<%= item.price %>" />
                          <select name="is_available">
                            <option value="1" <%= item.isAvailable ? 'selected' : '' %>>Available</option>
                            <option value="0" <%= !item.isAvailable ? 'selected' : '' %>>Unavailable</option>
                          </select>
                          <input type="file" name="image" accept="image/*" />
                          <textarea name="description" rows="2" placeholder="Description"><%= item.description || "" %></textarea>
                        </div>
                        <div class="admin-menu-edit-actions">
                          <button class="btn" type="submit">Save</button>
                          <button class="btn danger" type="submit" formaction="/admin/menu/<%= item.id %>/delete">Delete</button>
                        </div>
                        <input type="hidden" name="current_image_url" value="<%= item.image %>" />
                      </form>
                    </details>
                  </div>
                </article>
              <% }) %>
            <% } %>
            <div class="empty-state admin-menu-empty is-hidden">
              <h3>No items in this category.</h3>
              <p>Switch tabs or create a new item.</p>
            </div>
            <div class="empty-state search-empty is-hidden" data-search-empty="admin-menu">
              <h3>No menu items match your search.</h3>
              <p>Try another keyword or clear the search.</p>
            </div>
          </div>

        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
    <script>
      const menuTabs = document.querySelectorAll("[data-menu-tab]");
      const menuCards = document.querySelectorAll("[data-menu-category]");
      const emptyState = document.querySelector(".admin-menu-empty");
      const searchInput = document.querySelector('[data-search-input="admin-menu"]');
      const searchEmpty = document.querySelector('[data-search-empty="admin-menu"]');

      function normalize(value) {
        return (value || "").toString().toLowerCase();
      }

      function getActiveCategory() {
        const activeTab = document.querySelector("[data-menu-tab].active");
        if (activeTab && activeTab.dataset.menuTab) {
          return activeTab.dataset.menuTab;
        }
        return menuTabs.length ? menuTabs[0].dataset.menuTab : "food";
      }

      function updateMenuFilter() {
        const target = normalize(getActiveCategory());
        const query = normalize(searchInput ? searchInput.value : "");
        let categoryCount = 0;
        let visibleCount = 0;
        menuCards.forEach((card) => {
          const cardCategory = normalize(card.dataset.menuCategory);
          const inCategory = cardCategory === target;
          if (inCategory) categoryCount += 1;
          const text = normalize(card.dataset.searchText || card.textContent);
          const isMatch = inCategory && (!query || text.includes(query));
          card.classList.toggle("is-hidden", !isMatch);
          if (isMatch) visibleCount += 1;
        });
        if (emptyState) {
          emptyState.classList.toggle("is-hidden", categoryCount > 0 || query);
        }
        if (searchEmpty) {
          searchEmpty.classList.toggle("is-hidden", !query || visibleCount > 0);
        }
      }

      if (menuTabs.length && menuCards.length) {
        menuTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            menuTabs.forEach((btn) => btn.classList.remove("active"));
            tab.classList.add("active");
            updateMenuFilter();
          });
        });
        updateMenuFilter();
      }

      if (searchInput) {
        searchInput.addEventListener("input", updateMenuFilter);
      }
    </script>
  </body>
</html>

