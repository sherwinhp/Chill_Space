<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Promotions</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/header", {
        page: "admin",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile",
        hideTabs: true
      }) %>

      <main>
        <section class="section admin-section">
          <div class="section-head">
            <div>
              <h2>Manage Promotions</h2>
              <p>Create, update, or remove promotions.</p>
            </div>
            <a class="btn" href="/admin">Back to Admin</a>
          </div>

          <form class="admin-form" action="/admin/promotions" method="POST" enctype="multipart/form-data">
            <h3>Add Promotion</h3>
            <div class="admin-grid-form">
              <input name="title" type="text" placeholder="Title" required />
              <input name="code" type="text" placeholder="Code" />
              <input name="discount_percent" type="number" placeholder="Discount %" required />
              <input name="min_total" type="number" step="0.01" placeholder="Min Total" />
              <input name="start_date" type="date" required />
              <input name="end_date" type="date" required />
              <input name="image" type="file" accept="image/*" />
              <textarea name="description" rows="2" placeholder="Description"></textarea>
            </div>
            <button class="btn primary" type="submit">Create Promotion</button>
          </form>

          <div class="admin-table">
            <div class="admin-table-row admin-header">
              <span>ID</span>
              <span>Title</span>
              <span>Discount</span>
              <span>Code</span>
              <span>Actions</span>
            </div>
            <% promotions.forEach(function(promo) { %>
              <form class="admin-table-row" action="/admin/promotions/<%= promo.id %>" method="POST" enctype="multipart/form-data">
                <span><%= promo.id %></span>
                <input name="title" value="<%= promo.title %>" />
                <input name="discount_percent" type="number" value="<%= promo.discountPercent %>" />
                <input name="code" value="<%= promo.code %>" />
                <div class="admin-actions">
                  <button class="btn" type="submit">Save</button>
                  <button class="btn danger" type="submit" formaction="/admin/promotions/<%= promo.id %>/delete">Delete</button>
                </div>
                <input type="hidden" name="min_total" value="<%= promo.minTotal %>" />
                <input type="hidden" name="start_date" value="<%= promo.startDate ? promo.startDate.toISOString().slice(0,10) : '' %>" />
                <input type="hidden" name="end_date" value="<%= promo.endDate ? promo.endDate.toISOString().slice(0,10) : '' %>" />
                <input type="file" name="image" accept="image/*" />
                <input type="hidden" name="current_image_url" value="<%= promo.image %>" />
                <input type="hidden" name="description" value="<%= promo.description %>" />
              </form>
            <% }) %>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
  </body>
</html>
