<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Promotions</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("../partials/admin-header", { page: "admin-promotions" }) %>

      <main>
        <section class="section admin-section admin-vertical-cards">
          <div class="section-head split">
            <div>
              <h2>Manage Promotions</h2>
              <p>Create, update, or remove promotions.</p>
            </div>
            <div class="section-actions">
              <a class="btn ghost" href="/admin">Back to dashboard</a>
              <a class="btn primary admin-cta" href="/admin/promotions/new">Create promotion</a>
            </div>
          </div>

          <div class="event-tabs admin-menu-tabs">
            <button class="event-tab active" type="button" data-admin-tab="active">Active</button>
            <button class="event-tab" type="button" data-admin-tab="scheduled">Scheduled</button>
            <button class="event-tab" type="button" data-admin-tab="expired">Expired</button>
          </div>

          <div class="section-actions" style="margin-top: 12px;">
            <div class="search-field" style="max-width: 320px;">
              <select class="search-input" data-admin-rule-filter aria-label="Promotion visibility filter">
                <option value="all">All visibility rules</option>
                <option value="any">Anytime</option>
                <option value="first">First-timer</option>
                <option value="weekday">Weekday (Mon–Thu)</option>
                <option value="weekend">Weekend (Sat–Sun)</option>
                <option value="happy">Happy hour</option>
              </select>
            </div>
            <div class="mini-muted" style="color:#6c7082; font-size: 12px;">
              Tip: Use codes containing `FIRST`, `WEEKDAY`, `WEEKEND`, `HAPPY` to control visibility.
            </div>
          </div>

          <div class="admin-menu-grid">
            <% if (!promotions || !promotions.length) { %>
              <div class="empty-state">
                <h3>No promotions yet.</h3>
                <p>Create your first promotion to boost sales.</p>
              </div>
            <% } else { %>
              <% promotions.forEach(function(promo) { %>
                <% const status = promo.adminStatus || "active"; %>
                <article class="admin-menu-card" data-admin-category="<%= status %>" data-admin-rule="<%= promo.rule || 'any' %>">
                  <div class="admin-menu-media">
                    <% if (promo.image) { %>
                      <img src="<%= promo.image %>" alt="<%= promo.title %>" />
                    <% } else { %>
                      <div class="admin-room-placeholder">No Image</div>
                    <% } %>
                  </div>
                  <div class="admin-menu-body">
                    <div class="admin-menu-title">
                      <div>
                        <h3><%= promo.title %></h3>
                        <p>ID: <%= promo.id %></p>
                      </div>
                      <div class="admin-menu-price">
                        <span><%= promo.discountPercent %>%</span>
                      </div>
                    </div>
                    <% if (promo.description) { %>
                      <p class="admin-menu-desc"><%= promo.description %></p>
                    <% } %>
                    <div class="admin-menu-meta">
                      <span class="admin-menu-pill"><%= promo.code || "No code" %></span>
                      <span class="admin-menu-pill">Min $<%= Number(promo.minTotal || 0).toFixed(2) %></span>
                      <span class="admin-menu-pill">
                        <%= promo.rule === 'weekday' ? 'Weekday' : promo.rule === 'weekend' ? 'Weekend' : promo.rule === 'happy' ? 'Happy hour' : promo.rule === 'first' ? 'First timer' : 'Anytime' %>
                      </span>
                      <% if (promo.isHidden) { %>
                        <span class="admin-menu-pill unavailable">Admin hidden</span>
                      <% } else { %>
                        <% if (promo.eligibleNow) { %>
                          <span class="admin-menu-pill available">Visible now</span>
                        <% } %>
                      <% } %>
                      <span class="admin-menu-pill">Redeemed <%= Number(promo.redeemedCount || 0) %></span>
                      <span class="admin-menu-pill <%= status === "expired" ? "unavailable" : "available" %>">
                        <%= status %>
                      </span>
                    </div>
                    <details class="admin-menu-edit">
                      <summary class="btn">Edit promotion</summary>
                      <form action="/admin/promotions/<%= promo.id %>" method="POST" enctype="multipart/form-data">
                        <div class="admin-menu-edit-grid">
                          <label class="admin-menu-field">
                            <span>Title</span>
                            <input name="title" maxlength="120" required value="<%= promo.title %>" />
                          </label>
                          <label class="admin-menu-field">
                            <span>Code</span>
                            <input name="code" maxlength="24" value="<%= promo.code %>" />
                          </label>
                          <label class="admin-menu-field">
                            <span>Discount %</span>
                            <input name="discount_percent" type="number" min="1" max="100" step="0.01" value="<%= promo.discountPercent %>" />
                          </label>
                          <label class="admin-menu-field">
                            <span>Min total</span>
                            <input name="min_total" type="number" min="0" step="0.01" value="<%= promo.minTotal %>" />
                          </label>
                          <label class="admin-menu-field">
                            <span>Start date</span>
                            <input name="start_date" type="date" required value="<%= promo.startDate ? new Date(promo.startDate).toISOString().slice(0,10) : '' %>" />
                          </label>
                          <label class="admin-menu-field">
                            <span>End date</span>
                            <input name="end_date" type="date" required value="<%= promo.endDate ? new Date(promo.endDate).toISOString().slice(0,10) : '' %>" />
                          </label>
                          <label class="admin-inline-check" style="grid-column: 1 / -1;">
                            <input type="checkbox" name="is_hidden" value="1" <%= promo.isHidden ? 'checked' : '' %> />
                            Hide from users
                          </label>
                          <label class="admin-menu-field span-all">
                            <span>Image</span>
                            <input type="file" name="image" accept="image/*" />
                          </label>
                          <label class="admin-menu-field span-all">
                            <span>Description</span>
                            <textarea name="description" rows="2" maxlength="500" placeholder="Description"><%= promo.description || "" %></textarea>
                          </label>
                        </div>
                        <div class="admin-menu-edit-actions">
                          <button class="btn" type="submit">Save</button>
                          <button class="btn danger" type="submit" formaction="/admin/promotions/<%= promo.id %>/delete">Delete</button>
                        </div>
                        <input type="hidden" name="current_image_url" value="<%= promo.image %>" />
                      </form>
                    </details>

                    <details class="admin-menu-edit">
                      <summary class="btn">Redeemers</summary>
                      <% if (!promo.recentRedeemers || !promo.recentRedeemers.length) { %>
                        <p class="admin-menu-desc" style="margin-top: 10px;">No completed redemptions yet.</p>
                      <% } else { %>
                        <div class="admin-table" style="margin-top: 12px;">
                          <div class="admin-table-row admin-header" style="grid-template-columns: 1fr 1fr 140px 120px;">
                            <div>Name</div>
                            <div>Email</div>
                            <div>Used at</div>
                            <div>Invoice</div>
                          </div>
                          <% promo.recentRedeemers.forEach(function(r) { %>
                            <div class="admin-table-row" style="grid-template-columns: 1fr 1fr 140px 120px;">
                              <div><%= r.name %></div>
                              <div><%= r.email %></div>
                              <div><%= r.usedAt ? new Date(r.usedAt).toLocaleString() : '-' %></div>
                              <div>#<%= r.transactionId %></div>
                            </div>
                          <% }) %>
                        </div>
                        <p class="admin-menu-desc" style="margin-top: 10px;">
                          Total redeemed: <strong><%= Number(promo.redeemedCount || 0) %></strong> times by
                          <strong><%= Number(promo.redeemedUsers || 0) %></strong> user(s).
                        </p>
                      <% } %>
                    </details>
                  </div>
                </article>
              <% }) %>
            <% } %>
            <div class="empty-state admin-menu-empty is-hidden">
              <h3>No promotions in this view.</h3>
              <p>Switch tabs or create a new promotion.</p>
            </div>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>
    <script>
      const adminTabs = document.querySelectorAll("[data-admin-tab]");
      const adminCards = document.querySelectorAll("[data-admin-category]");
      const emptyState = document.querySelector(".admin-menu-empty");
      const ruleFilter = document.querySelector("[data-admin-rule-filter]");

      function normalize(value) {
        return (value || "").toString().toLowerCase();
      }

      function updateAdminFilter(category) {
        const target = normalize(category);
        const ruleTarget = ruleFilter ? normalize(ruleFilter.value) : "all";
        let visibleCount = 0;
        adminCards.forEach((card) => {
          const cardCategory = normalize(card.dataset.adminCategory);
          const cardRule = normalize(card.dataset.adminRule);
          const ruleMatch = ruleTarget === "all" ? true : cardRule === ruleTarget;
          const isMatch = cardCategory === target && ruleMatch;
          card.classList.toggle("is-hidden", !isMatch);
          if (isMatch) visibleCount += 1;
        });
        if (emptyState) {
          emptyState.classList.toggle("is-hidden", visibleCount > 0);
        }
      }

      if (adminTabs.length && adminCards.length) {
        adminTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            adminTabs.forEach((btn) => btn.classList.remove("active"));
            tab.classList.add("active");
            updateAdminFilter(tab.dataset.adminTab);
          });
        });
        updateAdminFilter(adminTabs[0].dataset.adminTab);
      }

      if (ruleFilter) {
        ruleFilter.addEventListener("change", () => {
          const active = document.querySelector("[data-admin-tab].active");
          const key = active ? active.dataset.adminTab : (adminTabs[0] ? adminTabs[0].dataset.adminTab : "active");
          updateAdminFilter(key);
        });
      }
    </script>
  </body>
</html>

