<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Menu | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "menu",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section menu-page">
          <div class="section-head split menu-hero">
            <div>
              <h2>Food, Drinks &amp; Themes</h2>
              <p>Enhance your gaming experience with snacks and themes.</p>
            </div>
            <div class="search-field">
              <input
                class="search-input"
                type="search"
                placeholder="Search menu"
                aria-label="Search menu"
                data-search-input="menu"
              />
            </div>
          </div>

          <div class="menu-tabs menu-tabs--menu">
            <button class="menu-tab active" data-category="food">Food</button>
            <button class="menu-tab" data-category="drink">Beverages</button>
            <button class="menu-tab" data-category="addon">Room Themes</button>
          </div>

          <% if (!menuItems || !menuItems.length) { %>
            <div class="empty-state">
              <h3>No menu items available.</h3>
              <p>Add items in the database to populate this page.</p>
            </div>
          <% } else { %>
            <div class="menu-grid" data-menu-grid>
              <% menuItems.forEach(function(item) { %>
                <% const categoryLabel = item.category === "food"
                  ? "Food"
                  : item.category === "drink"
                    ? "Beverage"
                    : "Theme"; %>
                <% const availabilityClass = item.stockStatus === "low_stock"
                  ? "low-stock"
                  : item.stockStatus === "out_of_stock" || item.stockStatus === "unavailable"
                    ? "unavailable"
                    : "available"; %>
                <article
                  class="menu-card <%= item.isOrderable ? "" : "is-unavailable" %>"
                  data-category="<%= item.category %>"
                  data-id="<%= item.id %>"
                  data-name="<%= item.name %>"
                  data-price="<%= item.price %>"
                  data-search-text="<%= [item.name, item.description, item.category].filter(Boolean).join(' ') %>"
                >
                  <div class="menu-head">
                    <% if (item.imageUrl) { %>
                      <div class="menu-media">
                        <img src="<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy" />
                      </div>
                    <% } else { %>
                      <div class="menu-icon">
                        <i class="bi bi-egg-fried"></i>
                      </div>
                    <% } %>
                    <div class="menu-info">
                      <span class="menu-category"><%= categoryLabel %></span>
                      <h3><%= item.name %></h3>
                      <p><%= item.description %></p>
                    </div>
                  </div>
                  <div class="menu-actions">
                    <div class="menu-meta">
                      <span class="price">$<%= item.price.toFixed(2) %></span>
                      <span class="availability <%= availabilityClass %>">
                        <%= item.stockLabel || (item.isAvailable ? "Available" : "Unavailable") %>
                      </span>
                    </div>
                    <button
                      class="btn primary add-to-cart"
                      type="button"
                      data-id="<%= item.id %>"
                      data-name="<%= item.name %>"
                      data-price="<%= item.price %>"
                      <%= item.isOrderable ? "" : "disabled" %>
                    >
                      Add to Cart
                    </button>
                  </div>
                </article>
              <% }) %>
            </div>
            <div class="empty-state menu-empty is-hidden">
              <h3>No items in this category.</h3>
              <p>Try another tab to see available items.</p>
            </div>
          <% } %>
        </section>

      </main>
      <%- include("partials/footer") %>
    </div>
    <script src="/menu.js"></script>
  </body>
</html>
