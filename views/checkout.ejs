<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
    <script src="https://www.paypal.com/sdk/js?client-id=<%= process.env.PAYPAL_CLIENT_ID %>&currency=SGD"></script>
    <script src="https://js.stripe.com/v3/"></script>
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section payment-page">
          <div class="payment-hero">
            <div class="payment-hero-text">
              <span class="eyebrow">Checkout</span>
              <h2>Choose your payment method</h2>
              <p>Complete payment to finalize your order.</p>
            </div>
            <div class="payment-hero-actions">
              <span class="hero-pill">Secure checkout</span>
              <a class="btn ghost" href="/cart">Back to cart</a>
            </div>
          </div>

          <div class="payment-layout">
            <div class="payment-column">
              <div
                class="payment-card"
                data-wallet-balance-cents="<%= Number(walletBalance || 0) %>"
                data-user-email="<%= session && session.email ? session.email : '' %>"
                data-user-name="<%= session && session.name ? session.name : '' %>"
                data-stripe-publishable-key="<%= process.env.STRIPE_PUBLISHABLE_KEY || '' %>"
              >
                <div class="payment-block">
                  <div class="payment-block-head">
                    <div>
                      <h3>Payment options</h3>
                      <p>Select one method below. PayPal is also available.</p>
                    </div>
                    <span class="payment-badge">Instant</span>
                  </div>
                  <div class="payment-methods">
                    <label class="payment-pill nets">
                      <input type="radio" name="paymentType" value="nets" />
                      <span class="pill-text">NETS QR</span>
                      <span class="pill-indicator"></span>
                    </label>
                    <label class="payment-pill paynow">
                      <input type="radio" name="paymentType" value="paynow" />
                      <span class="pill-text">PayNow</span>
                      <span class="pill-indicator"></span>
                    </label>
                    <label class="payment-pill grabpay">
                      <input type="radio" name="paymentType" value="grabpay" />
                      <span class="pill-text">GrabPay</span>
                      <span class="pill-indicator"></span>
                    </label>
                    <label class="payment-pill wallet">
                      <input type="radio" name="paymentType" value="wallet" />
                      <span class="pill-text">Pay with Wallet (Balance: $<%= (Number(walletBalance || 0) / 100).toFixed(2) %>)</span>
                      <span class="pill-indicator"></span>
                    </label>
                  </div>
                </div>

                <div class="payment-block payment-block-paypal">
                  <div class="payment-block-head">
                    <div>
                      <h4>PayPal</h4>
                      <p>Pay quickly with your PayPal balance or linked bank.</p>
                    </div>
                  </div>
                  <div id="paypal-button-container" class="paypal-button-container"></div>
                </div>

                <div class="payment-block stripe-card-form" data-stripe-card-form>
                  <h4>Pay with card</h4>
                  <p class="field-hint">Supported: Visa, Mastercard, Amex, Discover, JCB, Diners, UnionPay.</p>
                  <div class="field">
                    <span>Name on card</span>
                    <input type="text" data-card-name placeholder="Full name" />
                  </div>
                  <div class="field">
                    <span>Email</span>
                    <input type="email" data-card-email placeholder="you@example.com" />
                  </div>
                  <div class="field">
                    <span>Card number</span>
                    <div class="stripe-input stripe-input--brand">
                      <div id="card-number-element"></div>
                      <span class="card-brand-pill is-hidden" data-card-brand-pill></span>
                    </div>
                    <small class="field-hint card-brand" data-card-brand></small>
                  </div>
                  <div class="field-group">
                    <label class="field">
                      <span>Expiry (MM/YY)</span>
                      <div id="card-expiry-element" class="stripe-input"></div>
                    </label>
                    <label class="field">
                      <span>CVV</span>
                      <div id="card-cvc-element" class="stripe-input"></div>
                    </label>
                    <label class="field">
                      <span>Billing country</span>
                      <input
                        type="text"
                        data-card-country
                        placeholder="SG"
                        list="country-list"
                        autocomplete="country"
                      />
                    </label>
                  </div>
                  <div class="field">
                    <span>Postal code</span>
                    <input type="text" data-card-postal placeholder="Postal code" />
                    <small class="field-hint">Singapore (SG): 6 digits.</small>
                  </div>
                  <datalist id="country-list">
                    <option value="SG">Singapore</option>
                    <option value="MY">Malaysia</option>
                    <option value="ID">Indonesia</option>
                    <option value="TH">Thailand</option>
                    <option value="VN">Vietnam</option>
                    <option value="PH">Philippines</option>
                    <option value="BN">Brunei</option>
                    <option value="US">United States</option>
                    <option value="GB">United Kingdom</option>
                    <option value="AU">Australia</option>
                    <option value="NZ">New Zealand</option>
                    <option value="CA">Canada</option>
                    <option value="CN">China</option>
                    <option value="HK">Hong Kong</option>
                    <option value="TW">Taiwan</option>
                    <option value="JP">Japan</option>
                    <option value="KR">South Korea</option>
                    <option value="IN">India</option>
                    <option value="AE">United Arab Emirates</option>
                    <option value="DE">Germany</option>
                    <option value="FR">France</option>
                    <option value="IT">Italy</option>
                    <option value="ES">Spain</option>
                    <option value="NL">Netherlands</option>
                    <option value="SE">Sweden</option>
                    <option value="NO">Norway</option>
                    <option value="DK">Denmark</option>
                    <option value="CH">Switzerland</option>
                  </datalist>
                </div>

                <button class="btn primary payment-confirm" type="button" data-confirm-payment>
                  Confirm payment
                </button>
              </div>
            </div>

            <div class="payment-column">
              <div class="summary-card checkout-summary">
                <h3>Order summary</h3>
                <div class="summary-row">
                  <span>Items</span>
                  <strong data-checkout-count>0</strong>
                </div>
                <div class="summary-row">
                  <span>Promo code</span>
                  <div class="promo-inline">
                    <input
                      type="text"
                      placeholder="e.g. FIRST10"
                      data-promo-code
                      class="promo-input"
                    />
                    <button class="btn ghost" type="button" data-promo-apply>Apply</button>
                    <button class="btn ghost" type="button" data-promo-remove>Remove</button>
                  </div>
                </div>
                <div class="summary-row total">
                  <span>Total</span>
                  <strong data-checkout-total>$0.00</strong>
                </div>
              </div>

              <div class="order-table checkout-order">
                <div class="order-row order-head">
                  <span>Product</span>
                  <span>Qty</span>
                  <span>Price</span>
                  <span>Subtotal</span>
                </div>
                <div class="order-rows" data-checkout-items>
                  <p class="empty-note">No items yet.</p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>

      <%- include("partials/footer") %>
    </div>

    <div class="nets-modal" hidden data-nets-modal aria-hidden="true">
      <div class="nets-modal__backdrop"></div>
      <div class="nets-modal__panel" role="dialog" aria-modal="true" aria-labelledby="nets-modal-title">
        <div class="nets-modal__header">
          <h3 id="nets-modal-title">Scan NETS QR</h3>
          <button class="nets-modal__close" type="button" data-nets-cancel aria-label="Close NETS QR modal">x</button>
        </div>

        <div class="nets-modal__body">
          <div class="nets-modal__status" data-nets-status aria-live="polite">Generating QR...</div>
          <div class="nets-modal__spinner" data-nets-spinner></div>
          <img class="nets-modal__qr" data-nets-qr alt="NETS QR Code" hidden />
          <div class="nets-modal__timer" data-nets-timer>Time remaining: 5:00</div>
          <div class="nets-modal__hint">Do not close this window until payment is completed.</div>
        </div>

        <div class="nets-modal__footer">
          <button class="btn ghost" type="button" data-nets-cancel>Cancel payment</button>
        </div>
      </div>
    </div>

    <script src="/checkout.js"></script>
  </body>
</html>
