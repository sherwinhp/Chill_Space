<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "profile",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="auth-shell auth-shell--password">
          <div class="auth-card auth-card--password">
            <div class="auth-header">
              <h2>Change password</h2>
              <p>Use your current password to set a new one.</p>
            </div>
            <form class="auth-form" action="/profile/password" method="POST">
              <label>
                Current password
                <div class="password-field">
                  <input
                    id="current-password"
                    type="password"
                    name="current_password"
                    autocomplete="current-password"
                    placeholder="Enter current password"
                    required
                  />
                  <button class="password-toggle" type="button" data-target="current-password">
                    Show
                  </button>
                </div>
              </label>
              <label>
                New password
                <div class="password-field">
                  <input
                    id="new-password"
                    type="password"
                    name="new_password"
                    autocomplete="new-password"
                    placeholder="Enter new password"
                    required
                  />
                  <button class="password-toggle" type="button" data-target="new-password">
                    Show
                  </button>
                </div>
              </label>
              <label>
                Confirm new password
                <div class="password-field">
                  <input
                    id="confirm-new-password"
                    type="password"
                    name="confirm_password"
                    autocomplete="new-password"
                    placeholder="Re-enter new password"
                    required
                  />
                  <button class="password-toggle" type="button" data-target="confirm-new-password">
                    Show
                  </button>
                </div>
              </label>
              <p style="margin: 0; font-size: 12px; color: var(--muted);">
                Password must be at least 8 characters and include an uppercase letter and a
                special character.
              </p>
              <% if (message) { %>
                <p
                  class="auth-status"
                  style="color: <%= messageType === 'error' ? 'red' : 'green' %>;"
                >
                  <%= message %>
                </p>
              <% } %>
              <button class="btn primary full" type="submit">Update password</button>
            </form>
            <div class="auth-footer">
              <a href="/profile">Back to profile</a>
            </div>
          </div>
        </section>
      </main>

      <%- include("partials/footer") %>
    </div>

    <script>
      document.querySelectorAll(".password-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const input = document.getElementById(btn.dataset.target);
          if (!input) return;
          const nextType = input.type === "password" ? "text" : "password";
          input.type = nextType;
          btn.textContent = nextType === "password" ? "Show" : "Hide";
        });
      });
    </script>
  </body>
</html>
