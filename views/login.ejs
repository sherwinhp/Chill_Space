<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login</title>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(11, 13, 19, 0.65);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 50;
      padding: 1rem;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-card {
      width: min(420px, 100%);
      background: #ffffff;
      border-radius: 1rem;
      padding: 1.25rem;
      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.2);
    }

    .modal-card h3 {
      margin: 0 0 0.5rem;
      color: #13151d;
    }

    .modal-card p {
      margin: 0 0 1rem;
      color: #4d5363;
    }

    .modal-card input {
      width: 100%;
      padding: 0.65rem 0.75rem;
      border-radius: 0.65rem;
      border: 1px solid #cfd5e5;
      font-size: 1rem;
      letter-spacing: 0.15rem;
      text-align: center;
      margin-bottom: 0.75rem;
    }

    .modal-status {
      min-height: 1.3rem;
      margin: 0;
      font-size: 0.9rem;
      color: #be123c;
    }

    .otp-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 0.25rem;
    }

    .otp-timer {
      font-size: 0.85rem;
      color: #6b7280;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="glow"></div>
    <%- include("partials/header", {
      page: "",
      roomsLink: "/",
      bookingsLink: "/bookings",
      menuLink: "/menu",
      reviewsLink: "/reviews",
      eventsLink: "/events",
      profileLink: "/profile"
    }) %>

    <main>
      <section class="auth-shell">
        <div class="auth-card">
          <div class="auth-header">
            <h2>Welcome back</h2>
            <p>Sign in to manage bookings and reviews.</p>
          </div>
          <form id="login-form" class="auth-form">
            <label>
              Email
              <input type="email" name="email" placeholder="you@example.com" required />
            </label>
            <label>
              Password
              <div class="password-field">
                <input id="login-password" type="password" name="password" placeholder="********" required />
                <button class="password-toggle" type="button" data-target="login-password">Show</button>
              </div>
            </label>
            <a href="/forgot-password" style="font-size: 0.9rem;">Forgot password?</a>
            <button class="btn primary full" type="submit">Login</button>
            <p id="login-status" class="auth-status"></p>
          </form>
          <div class="auth-footer">
            <span>New here?</span>
            <a href="/register">Create an account</a>
          </div>
        </div>
      </section>
    </main>

    <%- include("partials/footer") %>
  </div>

  <div id="mock-2fa-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="mock-2fa-title">
    <div class="modal-card">
      <h3 id="mock-2fa-title">Verify your login</h3>
      <p>Enter the 6-digit code sent to your email to continue.</p>
      <form id="mock-2fa-form">
        <input id="mock-2fa-code" name="code" type="text" placeholder="6-digit code" maxlength="6" pattern="\d{6}" required />
        <button class="btn primary full" type="submit">Verify code</button>
      </form>
      <div class="otp-actions">
        <span id="mock-2fa-timer" class="otp-timer">Resend available in 60s</span>
        <button id="mock-2fa-resend" class="btn ghost" type="button" disabled>Resend code</button>
      </div>
      <p id="mock-2fa-status" class="modal-status"></p>
    </div>
  </div>

  <script>
    document.querySelectorAll('.password-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        const nextType = input.type === 'password' ? 'text' : 'password';
        input.type = nextType;
        btn.textContent = nextType === 'password' ? 'Show' : 'Hide';
      });
    });

    const statusEl = document.getElementById('login-status');
    const twoFaModal = document.getElementById('mock-2fa-modal');
    const twoFaForm = document.getElementById('mock-2fa-form');
    const twoFaCode = document.getElementById('mock-2fa-code');
    const twoFaStatus = document.getElementById('mock-2fa-status');
    const twoFaTimer = document.getElementById('mock-2fa-timer');
    const twoFaResend = document.getElementById('mock-2fa-resend');
    const twoFaVerifyBtn = twoFaForm.querySelector('button[type="submit"]');
    const params = new URLSearchParams(window.location.search);
    const redirectTo = params.get('redirect') || '/';
    let pendingChallengeId = null;
    let resendInterval = null;
    let resendReadyAt = 0;
    let verifying = false;

    function clearResendInterval() {
      if (resendInterval) {
        clearInterval(resendInterval);
        resendInterval = null;
      }
    }

    function startResendCooldown(durationMs) {
      clearResendInterval();
      const now = Date.now();
      resendReadyAt = now + durationMs;
      twoFaResend.disabled = true;
      updateResendTimer();
      resendInterval = setInterval(updateResendTimer, 1000);
    }

    function updateResendTimer() {
      const remainingMs = resendReadyAt - Date.now();
      if (remainingMs <= 0) {
        clearResendInterval();
        twoFaResend.disabled = false;
        twoFaTimer.textContent = 'Didn\'t receive the code?';
        return;
      }
      const remainingSec = Math.ceil(remainingMs / 1000);
      twoFaTimer.textContent = `Resend available in ${remainingSec}s`;
    }

    function openTwoFaModal(cooldownMs = 60000) {
      twoFaModal.classList.add('active');
      twoFaStatus.textContent = '';
      twoFaCode.value = '';
      twoFaCode.focus();
      startResendCooldown(cooldownMs);
    }

    function closeTwoFaModal() {
      twoFaModal.classList.remove('active');
    }

    twoFaModal.addEventListener('click', (event) => {
      if (event.target === twoFaModal) {
        closeTwoFaModal();
      }
    });

    if (params.get('reason') === 'checkout') {
      statusEl.style.color = '#22242c';
      statusEl.textContent = 'Please log in to continue checkout.';
    }
    document.getElementById('login-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      statusEl.textContent = '';
      const formData = new FormData(event.target);
      const payload = Object.fromEntries(formData.entries());
      try {
        const res = await fetch('/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error || 'Login failed');
        if (body.requires2fa && body.challengeId) {
          pendingChallengeId = body.challengeId;
          statusEl.style.color = '#22242c';
          statusEl.textContent = body.message || 'Enter your verification code to continue.';
          openTwoFaModal(body.resendAfterMs || 60000);
          return;
        }
        statusEl.style.color = 'green';
        statusEl.textContent = 'Logged in! Redirecting...';
        window.location.href = redirectTo;
      } catch (err) {
        statusEl.style.color = 'red';
        statusEl.textContent = err.message;
      }
    });

    twoFaForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!pendingChallengeId) {
        twoFaStatus.textContent = 'Session expired. Please log in again.';
        return;
      }
      if (verifying) return;
      verifying = true;
      twoFaVerifyBtn.disabled = true;

      try {
        const res = await fetch('/auth/verify-2fa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            challengeId: pendingChallengeId,
            code: twoFaCode.value.trim(),
          }),
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error || 'Verification failed');
        twoFaStatus.style.color = 'green';
        twoFaStatus.textContent = 'Verification successful. Redirecting...';
        window.location.href = redirectTo;
      } catch (err) {
        twoFaStatus.style.color = '#be123c';
        twoFaStatus.textContent = err.message;
        verifying = false;
        twoFaVerifyBtn.disabled = false;
      }
    });

    twoFaResend.addEventListener('click', async () => {
      if (!pendingChallengeId || twoFaResend.disabled) return;
      twoFaResend.disabled = true;
      twoFaStatus.style.color = '#22242c';
      twoFaStatus.textContent = 'Sending a new code...';
      try {
        const res = await fetch('/auth/resend-2fa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ challengeId: pendingChallengeId }),
        });
        const body = await res.json();
        if (!res.ok) {
          const retryAfterMs = body.retryAfterMs || 60000;
          twoFaStatus.style.color = '#be123c';
          twoFaStatus.textContent = body.error || 'Unable to resend code.';
          startResendCooldown(retryAfterMs);
          return;
        }
        twoFaStatus.style.color = 'green';
        twoFaStatus.textContent = body.message || 'A new code was sent.';
        startResendCooldown(body.resendAfterMs || 60000);
      } catch (err) {
        twoFaStatus.style.color = '#be123c';
        twoFaStatus.textContent = err.message;
        startResendCooldown(60000);
      }
    });
  </script>
</body>
</html>
