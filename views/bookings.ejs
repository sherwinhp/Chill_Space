<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bookings | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "bookings",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section">
          <div class="section-head split">
            <div>
              <h2>Your Bookings</h2>
              <p>Track the rooms you booked and the status of each request.</p>
            </div>
            <div class="search-field">
              <input
                class="search-input"
                type="search"
                placeholder="Search bookings"
                aria-label="Search bookings"
                data-search-input="bookings"
              />
            </div>
          </div>

          <% if (!isLoggedIn) { %>
            <div class="empty-state wide centered">
              <h3>Login required</h3>
              <p>Please log in to view your bookings.</p>
              <a class="btn primary" href="/login">Login</a>
            </div>
          <% } else { %>
            <div class="event-tabs booking-tabs">
              <button class="event-tab active" type="button" data-booking-tab="upcoming">
                Coming Soon
              </button>
              <button class="event-tab" type="button" data-booking-tab="history">
                History
              </button>
            </div>

            <div data-booking-panel="upcoming">
              <% if (!bookings || !bookings.length) { %>
                <div class="empty-state">
                  <h3>No upcoming bookings.</h3>
                  <p>Your next bookings will show up here.</p>
                </div>
              <% } else { %>
                <div class="booking-grid">
                  <% bookings.forEach(function(booking) { %>
                    <article
                      class="booking-card"
                      data-search-item="bookings"
                      data-search-scope="upcoming"
                      data-search-text="<%= [booking.roomName, booking.userName, booking.userEmail, booking.adminStatus, booking.paymentStatus, new Date(booking.startTime).toLocaleString(), new Date(booking.endTime).toLocaleString()].filter(Boolean).join(' ') %>"
                    >
                      <div class="booking-media">
                        <% if (booking.roomImage) { %>
                          <img src="<%= booking.roomImage %>" alt="<%= booking.roomName %>" />
                        <% } %>
                      </div>
                      <div class="booking-body">
                        <div class="booking-title">
                          <div>
                            <h3><%= booking.roomName %></h3>
                            <p><%= booking.userName %> - <%= booking.userEmail %></p>
                          </div>
                          <div class="price">
                            <% if (booking.totalPrice) { %>
                              <strong>$<%= Number(booking.totalPrice).toFixed(2) %></strong>
                              <span>Total</span>
                            <% } else { %>
                              <strong>-</strong>
                              <span>Total</span>
                            <% } %>
                          </div>
                        </div>
                        <div class="meta">
                          <span>
                            <strong>Start:</strong>
                            <%= new Date(booking.startTime).toLocaleString() %>
                          </span>
                          <span>
                            <strong>End:</strong>
                            <%= new Date(booking.endTime).toLocaleString() %>
                          </span>
                          <span>
                            <strong>Pax:</strong>
                            <%= booking.pax || 1 %>
                          </span>
                        </div>
                        <div class="status-row">
                          <span class="status-pill">Request: <%= booking.adminStatus %></span>
                          <span class="status-pill secondary">Payment: <%= booking.paymentStatus %></span>
                        </div>
                        <% if (booking.paymentStatus !== "cancelled") { %>
                          <form class="booking-cancel" action="/bookings/<%= booking.id %>/cancel" method="POST">
                            <button class="btn danger" type="submit">Cancel Booking</button>
                          </form>
                        <% } %>
                      </div>
                    </article>
                  <% }) %>
                </div>
                <div class="empty-state search-empty is-hidden" data-search-empty="bookings" data-search-scope="upcoming">
                  <h3>No bookings match your search.</h3>
                  <p>Try another keyword or clear the search.</p>
                </div>
              <% } %>
            </div>

            <div data-booking-panel="history" class="is-hidden">
              <% if (!pastBookings || !pastBookings.length) { %>
                <div class="empty-state">
                  <h3>No booking history.</h3>
                  <p>Past bookings will appear here once they are completed.</p>
                </div>
              <% } else { %>
                <div class="booking-grid">
                  <% pastBookings.forEach(function(booking) { %>
                    <article
                      class="booking-card"
                      data-search-item="bookings"
                      data-search-scope="history"
                      data-search-text="<%= [booking.roomName, booking.userName, booking.userEmail, booking.adminStatus, booking.paymentStatus, new Date(booking.startTime).toLocaleString(), new Date(booking.endTime).toLocaleString()].filter(Boolean).join(' ') %>"
                    >
                      <div class="booking-media">
                        <% if (booking.roomImage) { %>
                          <img src="<%= booking.roomImage %>" alt="<%= booking.roomName %>" />
                        <% } %>
                      </div>
                      <div class="booking-body">
                        <div class="booking-title">
                          <div>
                            <h3><%= booking.roomName %></h3>
                            <p><%= booking.userName %> - <%= booking.userEmail %></p>
                          </div>
                          <div class="price">
                            <% if (booking.totalPrice) { %>
                              <strong>$<%= Number(booking.totalPrice).toFixed(2) %></strong>
                              <span>Total</span>
                            <% } else { %>
                              <strong>-</strong>
                              <span>Total</span>
                            <% } %>
                          </div>
                        </div>
                        <div class="meta">
                          <span>
                            <strong>Start:</strong>
                            <%= new Date(booking.startTime).toLocaleString() %>
                          </span>
                          <span>
                            <strong>End:</strong>
                            <%= new Date(booking.endTime).toLocaleString() %>
                          </span>
                          <span>
                            <strong>Pax:</strong>
                            <%= booking.pax || 1 %>
                          </span>
                        </div>
                        <div class="status-row">
                          <span class="status-pill">Request: <%= booking.adminStatus %></span>
                          <span class="status-pill secondary">Payment: <%= booking.paymentStatus %></span>
                        </div>
                      </div>
                    </article>
                  <% }) %>
                </div>
                <div class="empty-state search-empty is-hidden" data-search-empty="bookings" data-search-scope="history">
                  <h3>No bookings match your search.</h3>
                  <p>Try another keyword or clear the search.</p>
                </div>
              <% } %>
            </div>
          <% } %>
        </section>
      </main>
      <%- include("partials/footer") %>
    </div>
    <script>
      const bookingTabs = document.querySelectorAll("[data-booking-tab]");
      const bookingPanels = document.querySelectorAll("[data-booking-panel]");
      if (bookingTabs.length && bookingPanels.length) {
        bookingTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            bookingTabs.forEach((btn) => btn.classList.remove("active"));
            tab.classList.add("active");
            const target = tab.dataset.bookingTab;
            bookingPanels.forEach((panel) => {
              const isTarget = panel.dataset.bookingPanel === target;
              panel.classList.toggle("is-hidden", !isTarget);
            });
          });
        });
      }
    </script>
    <script src="/search.js"></script>
  </body>
</html>
