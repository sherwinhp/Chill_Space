<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bookings | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "bookings",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section">
          <div class="section-head">
            <div>
              <h2>Your Bookings</h2>
              <p>Track the rooms you booked and the status of each request.</p>
            </div>
          </div>

          <% if (!isLoggedIn) { %>
            <div class="empty-state wide centered">
              <h3>Login required</h3>
              <p>Please log in to view your bookings.</p>
              <a class="btn primary" href="/login">Login</a>
            </div>
          <% } else { %>
            <form class="booking-form" action="/bookings" method="POST">
              <div class="booking-form-head">
                <div>
                  <h3>Book a room</h3>
                  <p>Help a caller lock in a time slot quickly.</p>
                </div>
              </div>
              <div class="booking-form-grid">
                <select name="room_id" required>
                  <option value="" disabled selected>Select a room</option>
                  <% rooms.forEach(function(room) { %>
                    <option value="<%= room.id %>"><%= room.name %> ($<%= room.pricePerHour %>/hr)</option>
                  <% }) %>
                </select>
                <input name="start_time" type="datetime-local" required />
                <input name="end_time" type="datetime-local" required />
                <input name="pax" type="number" min="1" placeholder="Pax" />
              </div>
              <button class="btn primary" type="submit">Create Booking</button>
            </form>

            <% if (!bookings || !bookings.length) { %>
              <div class="empty-state">
                <h3>No bookings yet.</h3>
                <p>Once you make a booking, it will appear here.</p>
              </div>
            <% } else { %>
              <div class="booking-grid">
                <% bookings.forEach(function(booking) { %>
                  <article class="booking-card">
                    <div class="booking-media">
                      <% if (booking.roomImage) { %>
                        <img src="<%= booking.roomImage %>" alt="<%= booking.roomName %>" />
                      <% } %>
                    </div>
                    <div class="booking-body">
                      <div class="booking-title">
                        <div>
                          <h3><%= booking.roomName %></h3>
                          <p><%= booking.userName %> - <%= booking.userEmail %></p>
                        </div>
                        <div class="price">
                          <% if (booking.totalPrice) { %>
                            <strong>$<%= Number(booking.totalPrice).toFixed(2) %></strong>
                            <span>Total</span>
                          <% } else { %>
                            <strong>-</strong>
                            <span>Total</span>
                          <% } %>
                        </div>
                      </div>
                      <div class="meta">
                        <span>
                          <strong>Start:</strong>
                          <%= new Date(booking.startTime).toLocaleString() %>
                        </span>
                        <span>
                          <strong>End:</strong>
                          <%= new Date(booking.endTime).toLocaleString() %>
                        </span>
                        <span>
                          <strong>Pax:</strong>
                          <%= booking.pax || 1 %>
                        </span>
                      </div>
                      <div class="status-row">
                        <span class="status-pill">Request: <%= booking.adminStatus %></span>
                        <span class="status-pill secondary">Payment: <%= booking.paymentStatus %></span>
                      </div>
                      <% if (booking.paymentStatus !== "cancelled") { %>
                        <form class="booking-cancel" action="/bookings/<%= booking.id %>/cancel" method="POST">
                          <button class="btn danger" type="submit">Cancel Booking</button>
                        </form>
                      <% } %>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } %>
          <% } %>
        </section>
      </main>
      <%- include("partials/footer") %>
    </div>
  </body>
</html>
