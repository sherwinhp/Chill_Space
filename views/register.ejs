<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register</title>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .password-strength {
      margin-top: 0.55rem;
    }

    .password-strength-meter {
      height: 8px;
      background: #e4e7f0;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 0.5rem;
    }

    .password-strength-fill {
      height: 100%;
      width: 0%;
      background: #ef4444;
      transition: width 0.2s ease, background 0.2s ease;
    }

    .password-strength-text {
      margin: 0 0 0.45rem;
      font-size: 0.86rem;
      color: #5e6678;
    }

    .password-rules {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0.2rem;
      font-size: 0.82rem;
      color: #6f7688;
    }

    .password-rules li::before {
      content: "\2717";
      color: #d9363e;
      margin-right: 0.4rem;
    }

    .password-rules li.ok {
      color: #156f3f;
    }

    .password-rules li.ok::before {
      content: "\2713";
      color: #1a8f50;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="glow"></div>
    <%- include("partials/header", {
      page: "",
      roomsLink: "/",
      bookingsLink: "/bookings",
      menuLink: "/menu",
      reviewsLink: "/reviews",
      eventsLink: "/events",
      profileLink: "/profile"
    }) %>

    <main>
      <section class="auth-shell">
        <div class="auth-card">
          <div class="auth-header">
            <h2>Create your account</h2>
            <p>Join Cozy Place and unlock booking perks.</p>
          </div>
          <form id="register-form" class="auth-form">
            <label>
              Username
              <input type="text" name="name" placeholder="e.g. janedoe" required />
            </label>
            <label>
              Email
              <input type="email" name="email" placeholder="e.g. jane@example.com" required />
            </label>
            <label>
              Password
              <div class="password-field">
                <input id="register-password" type="password" name="password" placeholder="Enter password" required />
                <button class="password-toggle" type="button" data-target="register-password">Show</button>
              </div>
              <div class="password-strength" aria-live="polite">
                <div class="password-strength-meter">
                  <div id="password-strength-fill" class="password-strength-fill"></div>
                </div>
                <p id="password-strength-text" class="password-strength-text">Strength: Too weak</p>
                <ul class="password-rules">
                  <li id="rule-length">At least 8 characters</li>
                  <li id="rule-uppercase">At least 1 uppercase letter</li>
                  <li id="rule-special">At least 1 special character</li>
                </ul>
              </div>
            </label>
            <label>
              Confirm password
              <div class="password-field">
                <input id="register-confirm-password" type="password" name="confirm_password" placeholder="Re-enter password" required />
                <button class="password-toggle" type="button" data-target="register-confirm-password">Show</button>
              </div>
            </label>
            <label>
              Address
              <input type="text" name="address" placeholder="123 Main St, Apt 4B" required />
            </label>
            <label>
              Contact number
              <input type="text" name="contact_number" placeholder="81234567" required />
            </label>
            <label>
              Birth date (DD/MM/YYYY)
              <input type="date" name="birth_date" placeholder="DD/MM/YYYY" />
            </label>
            <button class="btn primary full" type="submit">Register</button>
            <p id="register-status" class="auth-status"></p>
          </form>
          <div class="auth-footer">
            <span>Already have an account?</span>
            <a href="/login">Login</a>
          </div>
        </div>
      </section>
    </main>

    <%- include("partials/footer") %>
  </div>

  <script>
    document.querySelectorAll('.password-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        const nextType = input.type === 'password' ? 'text' : 'password';
        input.type = nextType;
        btn.textContent = nextType === 'password' ? 'Show' : 'Hide';
      });
    });

    const statusEl = document.getElementById('register-status');
    const passwordInput = document.getElementById('register-password');
    const confirmPasswordInput = document.getElementById('register-confirm-password');
    const strengthFill = document.getElementById('password-strength-fill');
    const strengthText = document.getElementById('password-strength-text');
    const rules = {
      length: document.getElementById('rule-length'),
      uppercase: document.getElementById('rule-uppercase'),
      special: document.getElementById('rule-special'),
    };

    function evaluatePasswordStrength(password) {
      const checks = {
        length: password.length >= 8,
        uppercase: /[A-Z]/.test(password),
        special: /[^\w\s]/.test(password),
      };
      const passed = Object.values(checks).filter(Boolean).length;

      Object.entries(checks).forEach(([key, ok]) => {
        rules[key].classList.toggle('ok', ok);
      });

      const strengthLevels = ['Too weak', 'Weak', 'Medium', 'Strong'];
      const strengthColors = ['#ef4444', '#f97316', '#eab308', '#16a34a'];
      strengthFill.style.width = `${(passed / 3) * 100}%`;
      strengthFill.style.background = strengthColors[passed];
      strengthText.textContent = `Strength: ${strengthLevels[passed]}`;

      return checks;
    }

    passwordInput.addEventListener('input', () => {
      evaluatePasswordStrength(passwordInput.value);
    });

    evaluatePasswordStrength(passwordInput.value);

    document.getElementById('register-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      statusEl.textContent = '';
      const formData = new FormData(event.target);
      const payload = Object.fromEntries(formData.entries());
      const checks = evaluatePasswordStrength(payload.password || '');
      if (!checks.length || !checks.uppercase || !checks.special) {
        statusEl.style.color = 'red';
        statusEl.textContent = 'Please create a stronger password before registering.';
        return;
      }
      if ((payload.password || '') !== (payload.confirm_password || '')) {
        statusEl.style.color = 'red';
        statusEl.textContent = 'Passwords do not match.';
        confirmPasswordInput.focus();
        return;
      }
      try {
        const res = await fetch('/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error || 'Registration failed');
        statusEl.style.color = 'green';
        statusEl.textContent = 'Registered! Redirecting...';
        window.location.href = '/';
      } catch (err) {
        statusEl.style.color = 'red';
        statusEl.textContent = err.message;
      }
    });
  </script>
</body>
</html>
