<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Purchase History | Cozy Place Gaming Rooms</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page">
      <div class="glow"></div>
      <%- include("partials/header", {
        page: "",
        roomsLink: "/",
        bookingsLink: "/bookings",
        menuLink: "/menu",
        reviewsLink: "/reviews",
        eventsLink: "/events",
        profileLink: "/profile"
      }) %>

      <main>
        <section class="section purchase-page">
          <% const totalSpent = transactions.reduce((sum, tx) => sum + Number(tx.total_amount || 0), 0); %>
          <div class="purchase-hero">
            <div class="purchase-hero-text">
              <span class="eyebrow">Orders</span>
              <h2>Purchase history</h2>
              <p>Your completed payments and itemized receipts.</p>
            </div>
            <div class="purchase-hero-actions">
              <div class="search-field">
                <input
                  class="search-input"
                  type="search"
                  placeholder="Search purchases"
                  aria-label="Search purchases"
                  data-search-input="purchases"
                />
              </div>
              <div class="purchase-stats">
                <div class="purchase-stat">
                  <span>Total orders</span>
                  <strong><%= transactions.length %></strong>
                </div>
                <div class="purchase-stat">
                  <span>Total spent</span>
                  <strong>$<%= totalSpent.toFixed(2) %></strong>
                </div>
              </div>
              <a class="btn ghost" href="/bookings">Back to bookings</a>
            </div>
          </div>

          <% if (!transactions.length) { %>
            <div class="empty-state wide centered">
              <h3>No purchases yet.</h3>
              <p>Payments you complete will appear here with full item details.</p>
              <a class="btn primary" href="/menu">Browse menu</a>
            </div>
          <% } else { %>
            <div class="purchase-grid">
              <% transactions.forEach(function(transaction) { %>
                <% const items = itemsByTransaction[transaction.transaction_id] || []; %>
                <div
                  class="purchase-card"
                  data-search-item="purchases"
                  data-search-text="<%= [transaction.transaction_id, transaction.status, transaction.provider, transaction.total_amount, new Date(transaction.created_at).toLocaleString(), items.map((item) => item.item_name).join(' '), items.map((item) => item.details).join(' ')].filter(Boolean).join(' ') %>"
                >
                  <div class="purchase-head">
                    <div>
                      <h3>Invoice #<%= transaction.transaction_id %></h3>
                      <p><%= new Date(transaction.created_at).toLocaleString() %></p>
                    </div>
                    <div class="purchase-total">
                      <span>Total</span>
                      <strong>$<%= Number(transaction.total_amount).toFixed(2) %></strong>
                    </div>
                  </div>

                  <div class="purchase-meta">
                    <span class="status-pill">Status: <%= transaction.status %></span>
                    <span class="status-pill secondary">Paid by: <%= transaction.provider %></span>
                  </div>

                  <div class="purchase-items">
                    <% items.forEach(function(item) { %>
                      <div class="purchase-item">
                        <div>
                          <strong><%= item.item_name %></strong>
                          <% if (item.details || item.start_time) { %>
                            <div class="order-meta">
                              <% if (item.details) { %>
                                <span><%= item.details %></span>
                              <% } %>
                              <% if (item.start_time && item.end_time) { %>
                                <span>
                                  <%= new Date(item.start_time).toLocaleString() %> -
                                  <%= new Date(item.end_time).toLocaleString() %>
                                </span>
                              <% } %>
                            </div>
                          <% } %>
                        </div>
                        <div class="purchase-item-meta">
                          <span>x<%= item.qty %></span>
                          <span>$<%= Number(item.subtotal).toFixed(2) %></span>
                        </div>
                      </div>
                    <% }) %>
                  </div>

                  <div class="purchase-actions">
                    <span class="purchase-count"><%= items.length %> item<%= items.length === 1 ? "" : "s" %></span>
                    <a class="btn ghost" href="/invoice/<%= transaction.transaction_id %>">View invoice</a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </section>
      </main>

      <%- include("partials/footer") %>
    </div>
  </body>
</html>
