<div class="page">
  <div class="glow"></div>
  <%- include("../partials/header", { page: "reviews" }) %>

  <main>
    <section class="section review-form-section">
      <div class="section-head">
        <div>
          <h2>Write a Review</h2>
          <p>Share your experience and help other students choose their perfect chill room.</p>
        </div>
      </div>

      <form action="/reviews/add" method="POST" class="review-form" enctype="multipart/form-data">
        <label class="field">
          <span>Room</span>
          <select name="roomId" id="roomSelect" required>
            <option value="" disabled selected>Select a room</option>
            <% (rooms || []).forEach(function(room) { %>
              <option value="<%= room.id %>"><%= room.name %></option>
            <% }) %>
          </select>
        </label>

        <div class="field-group">
          <div class="field">
            <span>Room Experience</span>
            <div class="star-rating" data-rating-group>
              <button type="button" data-value="1" aria-label="1 star">&#9733;</button>
              <button type="button" data-value="2" aria-label="2 stars">&#9733;</button>
              <button type="button" data-value="3" aria-label="3 stars">&#9733;</button>
              <button type="button" data-value="4" aria-label="4 stars">&#9733;</button>
              <button type="button" data-value="5" aria-label="5 stars">&#9733;</button>
            </div>
            <input type="hidden" name="ratingRoom" data-rating-input required />
          </div>

          <div class="field">
            <span>Food</span>
            <div class="star-rating" data-rating-group>
              <button type="button" data-value="1" aria-label="1 star">&#9733;</button>
              <button type="button" data-value="2" aria-label="2 stars">&#9733;</button>
              <button type="button" data-value="3" aria-label="3 stars">&#9733;</button>
              <button type="button" data-value="4" aria-label="4 stars">&#9733;</button>
              <button type="button" data-value="5" aria-label="5 stars">&#9733;</button>
            </div>
            <input type="hidden" name="ratingFood" data-rating-input required />
          </div>

          <div class="field">
            <span>Service</span>
            <div class="star-rating" data-rating-group>
              <button type="button" data-value="1" aria-label="1 star">&#9733;</button>
              <button type="button" data-value="2" aria-label="2 stars">&#9733;</button>
              <button type="button" data-value="3" aria-label="3 stars">&#9733;</button>
              <button type="button" data-value="4" aria-label="4 stars">&#9733;</button>
              <button type="button" data-value="5" aria-label="5 stars">&#9733;</button>
            </div>
            <input type="hidden" name="ratingService" data-rating-input required />
          </div>
        </div>

        <label class="field">
          <span>Your Review</span>
          <textarea
            name="comment"
            rows="5"
            placeholder="Tell us about your experience..."
            required
          ></textarea>
        </label>

        <label class="field">
          <span>Photo (optional)</span>
          <input type="file" name="photo" accept="image/*" />
          <small class="field-hint">PNG or JPG up to 3MB.</small>
        </label>

        <div class="form-actions">
          <button type="submit" class="btn primary full">Submit Review</button>
        </div>
      </form>
    </section>
  </main>

  <%- include("../partials/footer") %>
</div>

<script>
  const ratingGroups = document.querySelectorAll("[data-rating-group]");
  const roomSelect = document.getElementById("roomSelect");
  const params = new URLSearchParams(window.location.search);
  const prefillRoomId = params.get("roomId");

  if (roomSelect && prefillRoomId) {
    roomSelect.value = prefillRoomId;
  }

  ratingGroups.forEach((group) => {
    const stars = group.querySelectorAll("button");
    const input = group.parentElement.querySelector("[data-rating-input]");
    stars.forEach((star) => {
      star.addEventListener("click", () => {
        const rating = Number(star.getAttribute("data-value"));
        input.value = rating;
        stars.forEach((s) => {
          const value = Number(s.getAttribute("data-value"));
          s.classList.toggle("active", value <= rating);
        });
      });
    });
  });
</script>
