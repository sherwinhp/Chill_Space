<div class="page">
  <div class="glow"></div>
  <%- include("../partials/header", { page: "reviews" }) %>

  <main>
    <section class="section">
      <div class="section-head reviews-head">
        <div>
          <h2>User Reviews</h2>
          <p>Read feedback about our rooms, food, and service.</p>
        </div>
        <% if (session && session.userId) { %>
          <a href="/reviews/add" class="btn primary reviews-cta">Write a Review</a>
        <% } else { %>
          <a href="/login" class="btn primary reviews-cta">Login to Write a Review</a>
        <% } %>
      </div>

      <% if (reviews && reviews.length > 0) { %>
        <div class="reviews-grid">
          <% reviews.forEach(r => { %>
            <article class="review-card">
              <div class="review-top">
                <div class="avatar">
                  <%= r.name
                    ? r.name.split(" ").map(n => n[0]).slice(0,2).join("")
                    : "U" %>
                </div>
                <div class="review-meta">
                  <h4><%= r.name %></h4>
                  <div class="review-ratings">
                    <div>
                      <span class="review-label">Room</span>
                      <div class="stars">
                        <% for (let i = 0; i < r.rating; i++) { %>
                          <span>&#9733;</span>
                        <% } %>
                        <% for (let i = r.rating; i < 5; i++) { %>
                          <span class="muted">&#9733;</span>
                        <% } %>
                      </div>
                    </div>
                    <div>
                      <span class="review-label">Food</span>
                      <div class="stars">
                        <% for (let i = 0; i < r.ratingFood; i++) { %>
                          <span>&#9733;</span>
                        <% } %>
                        <% for (let i = r.ratingFood; i < 5; i++) { %>
                          <span class="muted">&#9733;</span>
                        <% } %>
                      </div>
                    </div>
                    <div>
                      <span class="review-label">Service</span>
                      <div class="stars">
                        <% for (let i = 0; i < r.ratingService; i++) { %>
                          <span>&#9733;</span>
                        <% } %>
                        <% for (let i = r.ratingService; i < 5; i++) { %>
                          <span class="muted">&#9733;</span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                  <% if (r.room) { %>
                    <div class="review-tags">
                      <span class="status-pill secondary"><%= r.room %></span>
                    </div>
                  <% } %>
                </div>
                <div class="review-date">
                  <%= r.date %>
                </div>
            </div>
            <p><%= r.text %></p>
            <% if (r.adminReply) { %>
              <div class="review-reply">
                <strong>Admin reply</strong>
                <p><%= r.adminReply %></p>
              </div>
            <% } %>
            <% if (r.imageUrl) { %>
              <div class="review-photo">
                <img src="<%= r.imageUrl %>" alt="Review photo from <%= r.name %>" />
              </div>
            <% } %>
            <% if (session && session.userId && r.userId && session.userId === r.userId) { %>
              <div class="review-actions">
                <a class="btn ghost" href="/reviews/edit/<%= r.id %>">Edit</a>
                <a class="btn danger" href="/reviews/delete/<%= r.id %>" onclick="return confirm('Delete this review?')">Delete</a>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
      <% } else { %>
        <div class="empty-state">
          <h3>No reviews yet.</h3>
          <p>Be the first to share your experience!</p>
        </div>
      <% } %>
    </section>
  </main>

  <%- include("../partials/footer") %>
</div>
