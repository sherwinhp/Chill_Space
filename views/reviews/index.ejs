<div class="page">
  <div class="glow"></div>
  <%- include("../partials/header", { page: "reviews" }) %>

  <main>
    <section class="section">
      <div class="section-head reviews-head">
        <div>
          <h2>Student Reviews</h2>
          <p>See what gamers and students are saying about us!</p>
        </div>
        <% if (session && session.userId) { %>
          <a href="/reviews/add" class="btn primary reviews-cta">Write a Review</a>
        <% } else { %>
          <a href="/login" class="btn primary reviews-cta">Login to Write a Review</a>
        <% } %>
      </div>

      <% if (reviews && reviews.length > 0) { %>
        <div class="reviews-grid">
          <% reviews.forEach(r => { %>
            <article class="review-card">
              <div class="review-top">
                <div class="avatar">
                  <%= r.user_name
                    ? r.user_name.split(" ").map(n => n[0]).slice(0,2).join("")
                    : "U" %>
                </div>
                <div class="review-meta">
                  <h4><%= r.user_name %></h4>
                  <div class="stars">
                    <% for (let i = 0; i < r.rating; i++) { %>
                    <span>&#9733;</span>
                    <% } %>
                    <% for (let i = r.rating; i < 5; i++) { %>
                      <span class="muted">&#9733;</span>
                    <% } %>
                  </div>
                </div>
                <div class="review-date">
                  <%= new Date(r.created_at).toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric"
                  }) %>
                </div>
            </div>
            <p><%= r.comment %></p>
            <% if (r.imageUrl) { %>
              <div class="review-photo">
                <img src="<%= r.imageUrl %>" alt="Review photo from <%= r.user_name %>" />
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
      <% } else { %>
        <div class="empty-state">
          <h3>No reviews yet.</h3>
          <p>Be the first to share your experience!</p>
        </div>
      <% } %>
    </section>
  </main>

  <%- include("../partials/footer") %>
</div>
