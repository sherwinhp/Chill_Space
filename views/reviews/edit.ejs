<%- include("../partials/header", { page: "reviews" }) %>

<h2>Edit Review</h2>

<form action="/reviews/edit/<%= review.review_id %>" method="POST" enctype="multipart/form-data">
    <label>Rating:</label>
    <input type="number" name="rating" value="<%= review.rating %>" min="1" max="5" required>

    <label>Comment:</label>
    <textarea name="comment" required><%= review.comment %></textarea>

    <label>Photo (optional):</label>
    <input type="file" name="photo" accept="image/*">
    <input type="hidden" name="currentImageUrl" value="<%= review.image_url || '' %>">

    <button type="submit">Save Changes</button>
</form>

<%- include("../partials/footer") %>
